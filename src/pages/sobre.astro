---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import juliaFoto from '../assets/images/julia-foto.png';
import logoImg from '../assets/images/logo.png';
import whatsappIcon from '../assets/icons/whatsapp.svg?raw';
import emailIcon from '../assets/icons/email.svg?raw';
import linkedinIcon from '../assets/icons/linkedin.svg?raw';
import copyIcon from '../assets/icons/copy.svg?raw';
import { SITE } from '../data/site';
import { CURRICULO } from '../data/curriculo';
---

<BaseLayout
  title="Sobre"
  description="Conheça a trajetória acadêmica e profissional da professora Júlia Demetrio Xavier (CEFET-MG e intercâmbio na Universidade Politécnica de Bragança, Portugal), serviços e canais de contato."
>
  <!-- 1. APRESENTAÇÃO & BIO -->
  <section class="section section-editorial about-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Sobre' }]} />

      <div class="about-hero-grid">
        <div class="about-hero-copy">
          <div class="about-brand-tag">
            <Image
              src={logoImg}
              alt="Logo Júlia Demetrio Xavier"
              width={180}
              height={120}
              class="about-brand-logo"
            />
          </div>
          <span class="eyebrow">Trajetória Acadêmica, Ensino & Revisão Textual</span>
          <h1>{SITE.name}</h1>
          <div class="hero-social-row">
            <a
              href={SITE.contact.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-social-pill"
              aria-label="Perfil no LinkedIn da professora Júlia Demetrio Xavier"
            >
              <Fragment set:html={linkedinIcon} />
              <span>Perfil no LinkedIn</span>
            </a>
          </div>
          <p class="lead about-bio">
            {CURRICULO.resumoProfissional}
          </p>

          <div class="about-quick-nav" aria-label="Atalhos desta página">
            <a href="#curriculo" class="btn btn-secondary">Formação & Experiência</a>
            <a href="#servicos" class="btn btn-secondary">Serviços</a>
            <a href="#contato" class="btn btn-primary">Entrar em Contato</a>
          </div>

          <div class="cred-cards-row">
            {
              CURRICULO.credenciaisDestaque.map((cred) => (
                <div class="cred-card">
                  <span class="cred-sigla">{cred.sigla}</span>
                  <strong class="cred-title">{cred.titulo}</strong>
                  <span class="cred-sub">{cred.subtitulo}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Retrato da Professora (sem cards sobrepostos na frente da foto/rosto) -->
        <div class="about-hero-visual">
          <div class="photo-frame">
            <div class="photo-halo" aria-hidden="true"></div>
            <div class="photo-ring" aria-hidden="true"></div>
            <Image
              src={juliaFoto}
              alt="Retrato da professora Júlia Demetrio Xavier"
              width={520}
              height={680}
              class="julia-portrait"
              loading="eager"
            />
          </div>
          <p class="photo-caption">
            Mestranda em Estudos de Linguagem (CEFET-MG) • Intercâmbio na Universidade Politécnica de Bragança (Portugal) • Graduada em Letras (CEFET-MG)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. FORMAÇÃO ACADÊMICA E EXPERIÊNCIA PROFISSIONAL -->
  <section class="section" id="curriculo">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Currículo Acadêmico e Profissional</span>
        <h2>Formação Acadêmica e Experiência</h2>
        <p class="lead">
          Formação universitária no CEFET-MG, intercâmbio internacional em Portugal e atuação em docência, correção de redações e revisão textual.
        </p>
      </div>

      <div class="about-columns">
        <!-- Coluna 1: Formação Acadêmica -->
        <div class="about-col">
          <h3 class="timeline-group-title">Formação Acadêmica</h3>
          <div class="timeline">
            {
              CURRICULO.formacao.map((item) => (
                <div class="timeline-item">
                  <div class="timeline-marker"></div>
                  <div class="card timeline-card">
                    <div class="tl-meta">
                      <span class="badge badge-gold">{item.periodo}</span>
                      <span class="tl-status">{item.status}</span>
                    </div>
                    <h4>{item.curso}</h4>
                    <p class="tl-inst">{item.instituicao}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Coluna 2: Experiência Profissional -->
        <div class="about-col">
          <h3 class="timeline-group-title">Experiência Profissional</h3>
          <div class="timeline">
            {
              CURRICULO.experiencia.map((exp) => (
                <div class="timeline-item">
                  <div class="timeline-marker"></div>
                  <div class="card timeline-card">
                    <div class="tl-meta">
                      <span class="badge badge-rose">{exp.periodo}</span>
                      {exp.instituicao && <span class="badge badge-gold">{exp.instituicao}</span>}
                    </div>
                    <h4>{exp.cargo}</h4>
                    {exp.instituicao && <p class="tl-inst">{exp.instituicao}</p>}
                    <ul class="tl-list">
                      {exp.atividades.map((ativ) => <li>{ativ}</li>)}
                    </ul>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SERVIÇOS (3 SERVIÇOS EM LINHA ÚNICA NO COMPUTADOR E LISTA VERTICAL NO MOBILE) -->
  <section class="section section-cream" id="servicos">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Acompanhamento Personalizado</span>
        <h2>Serviços</h2>
        <p class="lead">
          Acompanhamento individualizado em redação para o ENEM, aulas particulares de Língua Portuguesa e Literatura e revisão textual com normalização acadêmica.
        </p>
      </div>

      <div class="services-row">
        {
          CURRICULO.servicos.map((serv) => (
            <article class="card serv-detail-card" id={serv.slug}>
              <div class="serv-top">
                <span class="badge badge-rose">{serv.categoria}</span>
                <span class="serv-target">{serv.publicoAlvo}</span>
              </div>
              <h3>{serv.titulo}</h3>
              <p class="serv-summary">{serv.resumo}</p>

              <div class="serv-deliverables">
                <strong>O que está incluído:</strong>
                <ul>
                  {serv.entregaveis.map((item) => <li>{item}</li>)}
                </ul>
              </div>

              <div class="serv-actions">
                <a
                  href={`#contato`}
                  data-select-servico={serv.slug}
                  class="btn btn-primary serv-select-btn"
                  style="width: 100%;"
                >
                  Solicitar este serviço
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. CONTATO (AO FINAL DA PÁGINA) -->
  <section class="section" id="contato">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Atendimento Direto</span>
        <h2>Entre em Contato</h2>
        <p class="lead">
          Preencha o formulário abaixo para enviar sua mensagem por WhatsApp ou E-mail.
        </p>
      </div>

      <div class="contact-card-wrapper">
        <!-- Card Unificado: Entrar em Contato -->
        <div class="card contact-main-card">
          <div class="contact-card-header">
            <div>
              <h3>Entrar em Contato</h3>
              <p class="builder-sub">
                Selecione o assunto e informe os detalhes para direcionarmos sua mensagem:
              </p>
            </div>
            <a
              href={SITE.contact.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-sm btn-linkedin-header"
              aria-label="Acessar perfil profissional no LinkedIn"
            >
              <Fragment set:html={linkedinIcon} />
              <span>LinkedIn</span>
            </a>
          </div>

          <form id="contact-form" class="builder-form">
            <div class="form-group">
              <label for="nome-visitante">Seu nome (opcional)</label>
              <input
                type="text"
                id="nome-visitante"
                placeholder="Ex.: Mariana Silva"
                class="form-input"
              />
            </div>

            <div class="form-group">
              <label for="servico-select">Assunto de interesse</label>
              <div class="select-wrapper">
                <select id="servico-select" class="form-select-editorial">
                  {
                    CURRICULO.servicos.map((s) => (
                      <option value={s.slug} data-msg={s.mensagemWhatsApp}>
                        {s.titulo}
                      </option>
                    ))
                  }
                  <option
                    value="outro"
                    data-msg="Olá, professora Júlia! Vim pelo seu site e gostaria de conversar sobre uma proposta acadêmica/pedagógica."
                  >
                    Outro assunto / Convite acadêmico
                  </option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="detalhes-msg">Detalhes adicionais (opcional)</label>
              <textarea
                id="detalhes-msg"
                rows="3"
                placeholder="Conte brevemente seu objetivo (ex.: preparação para o ENEM, revisão de TCC, série escolar...)"
                class="form-input"></textarea>
            </div>

            <div class="contact-actions-row">
              <button type="button" id="btn-send-whatsapp" class="btn btn-primary btn-contact-submit">
                <Fragment set:html={whatsappIcon} />
                <span>Enviar por WhatsApp</span>
              </button>
              <button type="button" id="btn-send-email" class="btn btn-secondary btn-contact-submit">
                <Fragment set:html={emailIcon} />
                <span>Enviar por E-mail</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ phoneE164: SITE.contact.phoneE164, email: SITE.contact.email }}>
  const selectEl = document.getElementById('servico-select');

  // Pré-seleciona o serviço vindo da URL (?servico=slug)
  const params = new URLSearchParams(window.location.search);
  const servicoParam = params.get('servico');
  if (servicoParam && selectEl) {
    const optionExists = Array.from(selectEl.options).some((opt) => opt.value === servicoParam);
    if (optionExists) {
      selectEl.value = servicoParam;
    }
  }

  // Botões "Solicitar este serviço" nos cards de serviço pré-selecionam a opção e rolam até #contato
  document.querySelectorAll('.serv-select-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-select-servico');
      if (slug && selectEl) {
        selectEl.value = slug;
      }
    });
  });

  function getContactData() {
    const nome = document.getElementById('nome-visitante')?.value?.trim() || '';
    const detalhes = document.getElementById('detalhes-msg')?.value?.trim() || '';
    const selectedOption = selectEl?.options[selectEl.selectedIndex];
    const assuntoTitulo = selectedOption?.textContent?.trim() || 'Contato Geral';
    const baseMsg =
      selectedOption?.getAttribute('data-msg') ||
      'Olá, professora Júlia! Vim pelo seu site e gostaria de conversar.';

    return { nome, detalhes, assuntoTitulo, baseMsg };
  }

  // Envio por WhatsApp
  const btnWhatsapp = document.getElementById('btn-send-whatsapp');
  btnWhatsapp?.addEventListener('click', () => {
    const { nome, detalhes, baseMsg } = getContactData();

    let finalMsg = baseMsg;
    if (nome) {
      finalMsg = `Olá, professora Júlia! Meu nome é ${nome}. ` + baseMsg.replace(/^Olá, (professora )?Júlia!\s*/i, '');
    }
    if (detalhes) {
      finalMsg += `\n\nContexto: ${detalhes}`;
    }

    const url = `https://wa.me/${phoneE164}?text=${encodeURIComponent(finalMsg)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });

  // Envio por E-mail (mailto)
  const btnEmail = document.getElementById('btn-send-email');
  btnEmail?.addEventListener('click', () => {
    const { nome, detalhes, assuntoTitulo } = getContactData();

    const subject = `[Contato - Site] ${assuntoTitulo}`;
    let body = `Olá, professora Júlia!\n\n`;
    if (nome) {
      body += `Nome: ${nome}\n`;
    }
    body += `Assunto de interesse: ${assuntoTitulo}\n\n`;
    if (detalhes) {
      body += `Mensagem / Detalhes:\n${detalhes}\n\n`;
    } else {
      body += `Gostaria de mais informações sobre este serviço/assunto.\n\n`;
    }
    body += `---\nEnviado através do site juliademetrio.github.io`;

    const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailtoUrl;
  });
</script>

<style>
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  @media (min-width: 1024px) {
    .about-hero-grid {
      grid-template-columns: 1.25fr 0.9fr;
      gap: 3.5rem;
    }
  }

  .about-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
  }

  .about-brand-tag {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-cream-50);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-cream-300);
    box-shadow: var(--shadow-sm);
  }

  .about-brand-logo {
    width: 130px;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .about-bio {
    line-height: 1.75;
    color: var(--color-ink-700);
  }

  .about-quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .cred-cards-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .cred-cards-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cred-card {
    background-color: var(--color-cream-50);
    border: 1px solid var(--color-cream-300);
    border-left: 3px solid var(--color-wine-800);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    box-shadow: var(--shadow-sm);
  }

  .cred-sigla {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-rose-700);
  }

  .cred-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--color-wine-900);
    line-height: 1.25;
  }

  .cred-sub {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    line-height: 1.35;
  }

  /* Retrato sem sobreposição no rosto */
  .about-hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .photo-frame {
    position: relative;
    width: min(100%, 390px);
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .photo-halo {
    position: absolute;
    width: 88%;
    aspect-ratio: 1 / 1;
    top: 8%;
    border-radius: 50%;
    background: var(--gradient-photo-backdrop);
    z-index: 1;
  }

  .photo-ring {
    position: absolute;
    width: 82%;
    aspect-ratio: 1 / 1;
    top: 11%;
    border-radius: 50%;
    border: 1.5px solid var(--color-gold-300);
    opacity: 0.7;
    z-index: 1;
  }

  .julia-portrait {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 350px;
    height: auto;
    filter: drop-shadow(0 18px 34px rgba(104, 45, 52, 0.16));
  }

  .photo-caption {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    text-align: center;
    max-width: 38ch;
    background-color: var(--color-cream-50);
    border: 1px solid var(--color-cream-200);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  /* Cabeçalhos de Seção */
  .section-header {
    max-width: 68ch;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  /* Timeline Currículo */
  .about-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .about-columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  .timeline-group-title {
    font-size: 1.25rem;
    color: var(--color-wine-900);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-gold-300);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    position: relative;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-rose-200);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: -1.68rem;
    top: 1.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-wine-800);
    border: 2px solid var(--color-cream-50);
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .tl-status {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-500);
  }

  .tl-inst {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-wine-800);
  }

  .tl-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-700);
  }

  .tl-list {
    list-style: disc;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-sm);
    color: var(--color-ink-700);
    margin-top: 0.25rem;
  }

  /* Serviços: Lista vertical no mobile (1fr) e Linha única no computador (3 colunas) */
  .services-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .services-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .serv-detail-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .serv-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .serv-target {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    font-weight: 500;
  }

  .serv-detail-card h3 {
    font-size: 1.3rem;
  }

  .serv-summary {
    font-size: var(--text-sm);
    color: var(--color-ink-700);
  }

  .serv-deliverables {
    background-color: var(--color-cream-100);
    padding: 1rem 1.15rem;
    border-radius: var(--radius-sm);
    margin-top: auto;
  }

  .serv-deliverables strong {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-wine-900);
    margin-bottom: 0.45rem;
  }

  .serv-deliverables ul {
    list-style: disc;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-sm);
    color: var(--color-ink-700);
  }

  .serv-actions {
    padding-top: 0.35rem;
  }

  .hero-social-row {
    margin-top: -0.25rem;
    margin-bottom: 0.5rem;
  }

  .btn-social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-rose-300);
    background-color: var(--color-rose-50);
    color: var(--color-wine-900);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-social-pill:hover {
    background-color: var(--color-rose-100);
    border-color: var(--color-wine-800);
    color: var(--color-wine-800);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(104, 45, 52, 0.12);
  }

  /* Contato */
  .contact-card-wrapper {
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-main-card {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid var(--color-cream-300);
    box-shadow: 0 8px 30px rgba(104, 45, 52, 0.06);
  }

  @media (min-width: 640px) {
    .contact-main-card {
      padding: 2.25rem;
      gap: 1.5rem;
    }
  }

  .contact-card-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-cream-200);
  }

  @media (min-width: 640px) {
    .contact-card-header {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .contact-card-header h3 {
    margin: 0 0 0.35rem;
    font-size: 1.45rem;
    color: var(--color-wine-900);
  }

  .builder-sub {
    font-size: var(--text-sm);
    color: var(--color-ink-500);
    margin: 0;
  }

  .btn-linkedin-header {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    font-weight: 700;
    color: var(--color-wine-900);
    flex-shrink: 0;
  }

  .builder-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: var(--text-sm);
