---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProbableThemeCard from '../components/enem/ProbableThemeCard.astro';
import logoImg from '../assets/images/logo.png';
import whatsappIcon from '../assets/icons/whatsapp.svg?raw';
import arrowRightIcon from '../assets/icons/arrow-right.svg?raw';
import { SITE } from '../data/site';
import { EIXOS_LIST } from '../utils/eixos';
import {
  getTemasProvaveis,
  getTemasAnteriores,
  getRepertorio,
  getQuestoesComentadas,
} from '../utils/content';
import { url, buildWhatsAppUrl } from '../utils/urls';

const temasProvaveis = getTemasProvaveis();
const destaquesProvaveis = temasProvaveis.filter((t) => t.destaque).slice(0, 4);
const temasAnteriores = getTemasAnteriores();
const repertorio = getRepertorio();
const questoes = getQuestoesComentadas();

const whatsappHeroUrl = buildWhatsAppUrl(
  SITE.contact.phoneE164,
  'Olá, professora Júlia! Vim pelo seu Portal ENEM e gostaria de saber mais sobre aulas, mentoria de redação ou revisão textual.',
);
---

<BaseLayout
  title="Portal ENEM"
  description="Portal de estudos para o ENEM da professora Júlia Demetrio Xavier: possíveis temas de redação com livros, filmes e pensadores, temas anteriores (2010–2025), 5 competências e questões comentadas."
>
  <!-- 1. HERO DO PORTAL ENEM -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-main-grid">
        <div class="hero-copy">
          <span class="eyebrow">Portal Educacional • Redação, Literatura & Linguagens</span>
          <h1 class="hero-title">
            Portal de Estudos <span class="text-accent">ENEM</span> — Repertórios, Temas e Questões Comentadas
          </h1>
          <p class="lead hero-lead">
            Acervo pedagógico organizado pela professora <strong>{SITE.name}</strong> (mestranda em Estudos de Linguagem e graduada em Letras pelo <strong>CEFET-MG</strong>). Consulte apostas de redação com livros, filmes e filósofos, revise os temas cobrados desde 2010 e pratique com questões comentadas no navegador.
          </p>

          <div class="hero-ctas">
            <a href={url('/enem/simulado')} class="btn btn-primary btn-hero-simulado">
              Fazer Simulado ENEM Online
              <Fragment set:html={arrowRightIcon} />
            </a>
            <a href={url('/enem/exercicios')} class="btn btn-secondary">
              Banco de Questões
            </a>
            <a href={url('/enem/temas-provaveis')} class="btn btn-secondary">
              Temas Prováveis
            </a>
            <a href={url('/sobre')} class="btn btn-secondary">
              Sobre
            </a>
          </div>
        </div>

        <!-- Destaque do Logotipo Oficial -->
        <div class="hero-logo-showcase" aria-label="Identidade visual Júlia Demetrio Xavier">
          <div class="logo-display-card">
            <div class="logo-display-halo" aria-hidden="true"></div>
            <Image
              src={logoImg}
              alt="Logo oficial Júlia Demetrio Xavier — Professora e Revisora"
              width={380}
              height={253}
              class="hero-featured-logo"
              loading="eager"
            />
            <div class="logo-display-caption">
              <strong>Júlia Demetrio Xavier</strong>
              <span>Redação, Literatura & Linguagens</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Cards de Acesso Rápido do Portal ENEM -->
      <div class="hub-quick-cards">
        <a href={url('/enem/simulado')} class="card hub-stat-card hub-stat-featured">
          <span class="stat-num">45 Q</span>
          <strong>Simulado ENEM Online</strong>
          <span>Com cronômetro e alternativas embaralhadas</span>
        </a>
        <a href={url('/enem/exercicios')} class="card hub-stat-card">
          <span class="stat-num">{questoes.length}</span>
          <strong>Banco de Questões</strong>
          <span>Acervo oficial (2016–2025)</span>
        </a>
        <a href={url('/enem/temas-provaveis')} class="card hub-stat-card">
          <span class="stat-num">{temasProvaveis.length}</span>
          <strong>Temas Prováveis</strong>
          <span>Com repertórios e teses mapeadas</span>
        </a>
        <a href={url('/enem/repertorio')} class="card hub-stat-card">
          <span class="stat-num">{repertorio.length}</span>
          <strong>Banco de Repertório</strong>
          <span>Literatura, cinema, leis e pensadores</span>
        </a>
        <a href={url('/enem/temas-anteriores')} class="card hub-stat-card">
          <span class="stat-num">{temasAnteriores.length}</span>
          <strong>Temas Anteriores</strong>
          <span>Linha do tempo oficial do INEP</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. VITRINE DO HUB ENEM (BENTO GRID) -->
  <section class="section" id="hub-enem">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Acervo Aberto de Estudos</span>
        <h2>Recursos de Preparação para Redação e Linguagens</h2>
        <p class="lead">
          Conteúdos estruturados diretamente nas páginas do portal para consulta rápida no celular ou computador: possíveis temas com livros, filmes e pensadores, linha do tempo do ENEM e questões comentadas.
        </p>
      </div>

      <div class="bento-grid">
        <a href={url('/enem/temas-provaveis')} class="card bento-card bento-featured">
          <div class="bento-top">
            <span class="badge badge-gold">{temasProvaveis.length} Apostas Mapeadas</span>
            <span class="bento-arrow">→</span>
          </div>
          <h3>Possíveis Temas de Redação (2026/2027+)</h3>
          <p>
            Análise crítica dos temas mais cotados para as próximas edições do ENEM. Cada tema traz tese central, argumentos (D1 e D2), proposta de intervenção completa e indicações específicas de <strong>Livros</strong>, <strong>Filmes/Documentários</strong> e <strong>Textos de Repertório</strong>.
          </p>
          <div class="bento-chips">
            <span>Inteligência Artificial</span>
            <span>Adultização Infantil</span>
            <span>Apostas Online (Bets)</span>
            <span>Justiça Climática</span>
            <span>Saúde Mental Juvenil</span>
            <span>Neurodiversidade</span>
          </div>
        </a>

        <a href={url('/enem/repertorio')} class="card bento-card">
          <div class="bento-top">
            <span class="badge badge-rose">{repertorio.length} Repertórios</span>
            <span class="bento-arrow">→</span>
          </div>
          <h3>Banco de Livros, Filmes e Pensadores</h3>
          <p>
            Obras literárias, cinema, sociólogos, filósofos e marcos legais explicados com orientações práticas de como articular na redação sem cair no "repertório de bolso".
          </p>
        </a>

        <a href={url('/enem/temas-anteriores')} class="card bento-card">
          <div class="bento-top">
            <span class="badge badge-amber">{temasAnteriores.length} Edições (2010–2025)</span>
            <span class="bento-arrow">→</span>
          </div>
          <h3>Temas de Redação Anteriores</h3>
          <p>
            Todos os temas cobrados pelo INEP a partir de 2010 até 2025, com análise do recorte exigido pela banca e repertórios aplicáveis.
          </p>
        </a>

        <a href={url('/enem/competencias')} class="card bento-card">
          <div class="bento-top">
            <span class="badge badge-slate">Matriz Oficial + Método</span>
            <span class="bento-arrow">→</span>
          </div>
          <h3>As 5 Competências & Os 10 Passos</h3>
          <p>
            Guia completo dos critérios de correção de 0 a 1000 pontos e o método passo a passo para estruturar Introdução, Desenvolvimento e Conclusão.
          </p>
        </a>

        <a href={url('/enem/exercicios')} class="card bento-card">
          <div class="bento-top">
            <span class="badge badge-sage">Banco de Questões</span>
            <span class="bento-arrow">→</span>
          </div>
          <h3>Questões Comentadas</h3>
          <p>
            Consulte as questões dos cadernos de Linguagens dos últimos 10 anos do ENEM, com gabarito oficial do INEP e resolução comentada detalhada.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. NAVEGAÇÃO PELOS 7 EIXOS TEMÁTICOS -->
  <section class="section section-cream">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Organização por Eixos</span>
        <h2>Os 7 Eixos Temáticos da Redação do ENEM</h2>
        <p class="lead">
          Clique em um eixo para filtrar diretamente os temas prováveis ou os repertórios socioculturais correspondentes:
        </p>
      </div>

      <div class="grid-3">
        {
          EIXOS_LIST.map((eixo) => {
            const countProvaveis = temasProvaveis.filter((t) => t.eixo === eixo.slug).length;
            const countRepertorio = repertorio.filter((r) => r.eixos.includes(eixo.slug)).length;
            return (
              <article class="card axis-card">
                <div class="axis-top">
                  <span class={`badge ${eixo.badgeClass}`}>{eixo.shortLabel}</span>
                  <span class="axis-counts">
                    {countProvaveis} temas • {countRepertorio} repertórios
                  </span>
                </div>
                <h3>{eixo.label}</h3>
                <p>{eixo.description}</p>
                <div class="axis-links">
                  <a href={url(`/enem/temas-provaveis?eixo=${eixo.slug}`)} class="axis-link">
                    Ver temas do eixo →
                  </a>
                  <a href={url(`/enem/repertorio?eixo=${eixo.slug}`)} class="axis-link">
                    Ver repertórios →
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 4. AMOSTRA DOS TEMAS PROVÁVEIS EM DESTAQUE -->
  <section class="section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Preparação para os Próximos Anos</span>
          <h2>Apostas em Destaque com Repertório Completo</h2>
        </div>
        <a href={url('/enem/temas-provaveis')} class="btn btn-secondary">
          Ver todos os {temasProvaveis.length} temas prováveis
        </a>
      </div>

      <div class="grid-2">
        {destaquesProvaveis.map((tema) => <ProbableThemeCard tema={tema} />)}
      </div>
    </div>
  </section>

  <!-- 5. BANNER PARA PÁGINA SOBRE (TRAJETÓRIA, SERVIÇOS E CONTATO) -->
  <section class="section section-editorial">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-banner-copy">
          <span class="eyebrow">Professora Júlia Demetrio Xavier</span>
          <h2>Conheça a trajetória da professora, serviços e canais de contato</h2>
          <p class="lead">
            Precisa de mentoria e correção de redação para o ENEM, aulas particulares de Português e Literatura ou revisão textual e normalização ABNT? Acesse a página Sobre para conhecer o currículo, os serviços e entrar em contato.
          </p>
        </div>
        <div class="cta-banner-actions">
          <a href={url('/sobre')} class="btn btn-primary">
            Acessar Página Sobre
          </a>
          <a href={whatsappHeroUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Fragment set:html={whatsappIcon} />
            Chamar no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    background: var(--gradient-editorial);
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--color-cream-200);
  }

  .hero-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-main-grid {
      grid-template-columns: 1.3fr 0.9fr;
      gap: 2.75rem;
      align-items: flex-start;
    }
  }

  .hero-logo-showcase {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: -0.75rem;
  }

  @media (min-width: 1024px) {
    .hero-logo-showcase {
      margin-top: -1.25rem;
      align-self: flex-start;
    }
  }

  .logo-display-card {
    position: relative;
    width: 100%;
    max-width: 360px;
    background-color: var(--color-cream-50);
    border: 1px solid var(--color-cream-300);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem 1.25rem;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    overflow: hidden;
  }

  .logo-display-halo {
    position: absolute;
    width: 240px;
    height: 240px;
    top: -40px;
    background: radial-gradient(circle, rgba(226, 200, 157, 0.35) 0%, rgba(253, 251, 248, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-featured-logo {
    position: relative;
    width: 100%;
    max-width: 280px;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 4px 12px rgba(104, 45, 52, 0.08));
  }

  .logo-display-caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-cream-200);
    width: 100%;
  }

  .logo-display-caption strong {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-wine-900);
  }

  .logo-display-caption span {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .hero-copy {
    max-width: 78ch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
  }

  .hero-title {
    font-size: var(--text-display);
    line-height: 1.12;
  }

  .text-accent {
    color: var(--color-wine-800);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-300);
    text-underline-offset: 6px;
  }

  .hero-lead strong {
    color: var(--color-ink-900);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.25rem;
    width: 100%;
  }

  @media (max-width: 480px) {
    .hero-ctas .btn {
      width: 100%;
    }
  }

  .hub-quick-cards {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .hub-quick-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .hub-quick-cards {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .btn-hero-simulado {
    background-color: var(--color-gold-500);
    color: var(--color-ink-900);
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    border: 1px solid var(--color-gold-400);
  }

  .btn-hero-simulado:hover {
    background-color: var(--color-gold-400);
    transform: translateY(-2px);
  }

  .hub-stat-featured {
    border-color: var(--color-gold-400);
    background: linear-gradient(135deg, var(--color-cream-50) 0%, var(--color-rose-50) 100%);
  }

  .hub-stat-featured .stat-num {
    color: var(--color-wine-800);
  }

  .hub-stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.15rem;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-wine-800);
    line-height: 1.1;
  }

  .hub-stat-card strong {
    font-size: var(--text-sm);
    color: var(--color-ink-900);
  }

  .hub-stat-card span:last-child {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  /* Cabeçalhos de Seção */
  .section-header {
    max-width: 68ch;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .section-header-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  @media (min-width: 768px) {
    .section-header-row {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  /* Bento Grid ENEM */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-featured {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .bento-featured {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .bento-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bento-featured {
    background: linear-gradient(145deg, var(--color-cream-50) 0%, var(--color-rose-50) 100%);
    border-color: var(--color-rose-200);
  }

  .bento-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bento-arrow {
    font-size: 1.25rem;
    color: var(--color-wine-800);
    font-weight: 700;
  }

  .bento-chips {
    margin-top: auto;
    padding-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .bento-chips span {
    font-size: var(--text-xs);
    font-weight: 600;
    background-color: var(--color-cream-50);
    border: 1px solid var(--color-rose-200);
    color: var(--color-wine-900);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  /* Eixos */
  .axis-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .axis-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .axis-counts {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    font-weight: 600;
  }

  .axis-card h3 {
    font-size: 1.15rem;
  }

  .axis-card p {
    font-size: var(--text-sm);
  }

  .axis-links {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .axis-link {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-wine-800);
  }

  .axis-link:hover {
    text-decoration: underline;
  }

  /* Banner Final */
  .cta-banner {
    background-color: var(--color-cream-50);
    border: 1px solid var(--color-rose-200);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  @media (min-width: 1024px) {
    .cta-banner {
      flex-direction: row;
      align-items: center;
    }
  }

  .cta-banner-copy {
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .cta-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    flex-shrink: 0;
  }
</style>
