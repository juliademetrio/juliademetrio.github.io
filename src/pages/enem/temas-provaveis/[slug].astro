---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import RepertoireCard from '../../../components/enem/RepertoireCard.astro';
import {
  getTemasProvaveis,
  getRepertorioForTema,
  type TemaProvavel,
} from '../../../utils/content';
import { getEixoMeta } from '../../../utils/eixos';
import { url } from '../../../utils/urls';

export function getStaticPaths() {
  const temas = getTemasProvaveis();
  return temas.map((tema) => ({
    params: { slug: tema.slug },
    props: { tema },
  }));
}

interface Props {
  tema: TemaProvavel;
}

const { tema } = Astro.props;
const eixoMeta = getEixoMeta(tema.eixo);
const repertorio = getRepertorioForTema(tema);
---

<BaseLayout
  title={tema.titulo}
  description={`Frase-tema: "${tema.fraseTemaSugerida}". Veja tese, argumentos e repertórios de livros, filmes e textos para este possível tema de redação do ENEM.`}
>
  <section class="section section-editorial">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Portal ENEM', href: '/' },
          { label: 'Temas Prováveis', href: '/enem/temas-provaveis' },
          { label: tema.titulo },
        ]}
      />

      <div class="theme-badges">
        <span class={`badge ${eixoMeta.badgeClass}`}>{eixoMeta.label}</span>
        {tema.destaque && <span class="badge badge-gold">Aposta em Destaque</span>}
      </div>

      <h1 class="theme-h1">{tema.titulo}</h1>

      <div class="official-prompt-box">
        <span class="prompt-label">Proposta de Frase-Tema no Padrão INEP:</span>
        <p class="prompt-phrase">"{tema.fraseTemaSugerida}"</p>
        <div class="prompt-keywords">
          <span>Palavras-chave obrigatórias:</span>
          {tema.palavrasChave.map((kw) => <span class="kw-pill">{kw}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Estrutura Argumentativa (Tese, D1, D2 e Proposta de Intervenção) -->
  <section class="section">
    <div class="container">
      <div class="analysis-grid">
        <article class="card analysis-card">
          <span class="eyebrow">Contextualização</span>
          <h2>Por que este tema tem alta chance de cair?</h2>
          <p>{tema.porQuePodeCair}</p>
        </article>

        <article class="card analysis-card highlight-thesis">
          <span class="eyebrow">Projeto de Texto (Introdução)</span>
          <h2>Tese Central Sugerida</h2>
          <p>{tema.teseCentral}</p>
        </article>
      </div>

      <div class="arguments-grid" style="margin-top: 1.5rem;">
        <article class="card arg-card">
          <span class="badge badge-rose">1º Parágrafo de Desenvolvimento</span>
          <h3>{tema.argumentoD1.titulo}</h3>
          <p>{tema.argumentoD1.desenvolvimento}</p>
        </article>

        <article class="card arg-card">
          <span class="badge badge-rose">2º Parágrafo de Desenvolvimento</span>
          <h3>{tema.argumentoD2.titulo}</h3>
          <p>{tema.argumentoD2.desenvolvimento}</p>
        </article>
      </div>

      <!-- Proposta de Intervenção C5 -->
      <div class="card c5-box" style="margin-top: 1.5rem;">
        <div class="c5-header">
          <span class="badge badge-gold">Competência 5 (200 pontos)</span>
          <h2>Matriz da Proposta de Intervenção (5 Elementos)</h2>
        </div>

        <div class="c5-elements-grid">
          <div class="c5-el">
            <strong>1. Agente Social</strong>
            <p>{tema.propostaIntervencao.agente}</p>
          </div>
          <div class="c5-el">
            <strong>2. Detalhamento</strong>
            <p>{tema.propostaIntervencao.detalhamento}</p>
          </div>
          <div class="c5-el">
            <strong>3. Ação Prática</strong>
            <p>{tema.propostaIntervencao.acao}</p>
          </div>
          <div class="c5-el">
            <strong>4. Meio / Modo</strong>
            <p>{tema.propostaIntervencao.meioModo}</p>
          </div>
          <div class="c5-el c5-full">
            <strong>5. Efeito / Finalidade</strong>
            <p>{tema.propostaIntervencao.efeito}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REPERTÓRIOS VINCULADOS: LIVROS, FILMES E TEXTOS -->
  <section class="section section-cream">
    <div class="container">
      <div class="rep-sec-header">
        <span class="eyebrow">Competência 2 — Repertório Legitimado e Produtivo</span>
        <h2>Livros, Filmes e Textos de Repertório para este Tema</h2>
        <p class="lead">
          Obras literárias, produções cinematográficas e referenciais teóricos/legais selecionados especificamente para fundamentar sua argumentação sobre este tema:
        </p>
      </div>

      <!-- 1. LIVROS -->
      <div class="repertoire-category-block">
        <h3 class="cat-title">
          <span>1. Livros e Obras Literárias</span>
          <span class="badge badge-gold">{repertorio.livros.length} indicações</span>
        </h3>
        <div class="grid-2">
          {repertorio.livros.map((item) => <RepertoireCard item={item} />)}
        </div>
      </div>

      <!-- 2. FILMES E DOCUMENTÁRIOS -->
      <div class="repertoire-category-block">
        <h3 class="cat-title">
          <span>2. Filmes, Séries e Documentários</span>
          <span class="badge badge-rose">{repertorio.filmes.length} indicações</span>
        </h3>
        <div class="grid-2">
          {repertorio.filmes.map((item) => <RepertoireCard item={item} />)}
        </div>
      </div>

      <!-- 3. TEXTOS DE REPERTÓRIO (PENSADORES, LEIS E ESTUDOS) -->
      <div class="repertoire-category-block">
        <h3 class="cat-title">
          <span>3. Textos de Repertório: Filósofos, Sociólogos, Leis e Documentos</span>
          <span class="badge badge-sage">{repertorio.textos.length} indicações</span>
        </h3>
        <div class="grid-2">
          {repertorio.textos.map((item) => <RepertoireCard item={item} />)}
        </div>
      </div>

      <div class="back-nav">
        <a href={url('/enem/temas-provaveis')} class="btn btn-secondary">
          ← Voltar para todos os Temas Prováveis
        </a>
        <a href={url('/sobre?servico=mentoria-redacao-enem#contato')} class="btn btn-primary">
          Treinar este tema na Mentoria com a Profª Júlia
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .theme-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .theme-h1 {
    max-width: 28ch;
    margin-bottom: 1.5rem;
  }

  .official-prompt-box {
    background-color: var(--color-cream-50);
    border: 2px solid var(--color-gold-300);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow-sm);
  }

  .prompt-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-rose-700);
    margin-bottom: 0.4rem;
  }

  .prompt-phrase {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 700;
    color: var(--color-wine-900);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .prompt-keywords {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  .kw-pill {
    background-color: var(--color-rose-50);
    color: var(--color-wine-800);
    border: 1px solid var(--color-rose-200);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  .analysis-grid,
  .arguments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .analysis-grid,
    .arguments-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .analysis-card,
  .arg-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .analysis-card h2,
  .arg-card h3 {
    font-size: 1.25rem;
  }

  .highlight-thesis {
    background-color: var(--color-rose-50);
    border-color: var(--color-rose-200);
  }

  .c5-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .c5-header h2 {
    font-size: 1.35rem;
  }

  .c5-elements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .c5-elements-grid {
      grid-template-columns: 1fr 1fr;
    }
    .c5-full {
      grid-column: span 2;
    }
  }

  .c5-el {
    background-color: var(--color-cream-100);
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-gold-500);
  }

  .c5-el strong {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-wine-900);
    margin-bottom: 0.25rem;
  }

  .c5-el p {
    font-size: var(--text-sm);
    color: var(--color-ink-900);
  }

  .rep-sec-header {
    max-width: 68ch;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .repertoire-category-block {
    margin-bottom: 2.5rem;
  }

  .cat-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 1.3rem;
    color: var(--color-wine-900);
    padding-bottom: 0.65rem;
    margin-bottom: 1.15rem;
    border-bottom: 2px solid var(--color-gold-300);
  }

  .back-nav {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-cream-300);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
