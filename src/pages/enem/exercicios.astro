---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import QuestionCard from '../../components/enem/QuestionCard.astro';
import { getQuestoesComentadas } from '../../utils/content';

const questoes = getQuestoesComentadas();
const cadernos = [
  'Todos os documentos',
  ...Array.from(new Set(questoes.map((q) => q.caderno || 'ENEM 2025 — Caderno 3 Branco'))),
];
const categorias = ['Todas', ...Array.from(new Set(questoes.map((q) => q.categoria)))];
---

<BaseLayout
  title="Questões Comentadas"
  description="Pratique online com todas as 91 questões comentadas do ENEM 2025 (Caderno 3 Branco), do E-book de Linguagens e da Apostila de Linguagens, Códigos e suas Tecnologias."
>
  <section class="section section-editorial">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Portal ENEM', href: '/' },
          { label: 'Questões Comentadas Online' },
        ]}
      />
      <span class="eyebrow">Prática Interativa no Navegador</span>
      <h1>Caderno de Questões Comentadas Online ({questoes.length} Questões)</h1>
      <p class="lead" style="max-width: 68ch; margin-top: 0.75rem;">
        Resolva todas as <strong>{questoes.length} questões</strong> dos materiais de <strong>Linguagens, Códigos e suas Tecnologias</strong> (Prova ENEM 2025 Caderno 3 Branco completa, E-book de Questões Comentadas e Apostila de Linguagens) diretamente no navegador. Clique em uma alternativa para corrigir na hora ou use o botão <strong>Limpar seleções</strong> para refazer seu treino.
      </p>
    </div>
  </section>

  <!-- Resumos Rápidos de Teoria -->
  <section class="section section-cream">
    <div class="container">
      <div class="theory-header">
        <span class="eyebrow">Sínteses de Revisão Rápida</span>
        <h2>Tópicos Mais Cobrados em Linguagens no ENEM</h2>
      </div>

      <div class="grid-2">
        <article class="card theory-card">
          <h3>1. Variação Linguística vs. Norma-Padrão</h3>
          <p>
            O ENEM avalia a língua sob a perspectiva sociolinguística: não existe variedade "certa" ou "errada" em absoluto, mas <strong>adequação à situação comunicativa e ao gênero textual</strong>. As variações podem ser regionais/geográficas (diatópicas), sociais (diastráticas), históricas (diacrônicas) ou de registro/estilo (diafásicas).
          </p>
        </article>

        <article class="card theory-card">
          <h3>2. As 6 Funções da Linguagem</h3>
          <p>
            <strong>Referencial:</strong> foco no contexto/informação objetiva (jornalismo). <strong>Emotiva:</strong> foco no emissor/1ª pessoa. <strong>Conativa/Apelativa:</strong> foco no receptor/verbos no imperativo (publicidade). <strong>Poética:</strong> foco na elaboração estética da mensagem. <strong>Fática:</strong> foco no canal de contato. <strong>Metalinguística:</strong> o código explicando o próprio código.
          </p>
        </article>

        <article class="card theory-card">
          <h3>3. Informações Implícitas: Pressupostos e Subentendidos</h3>
          <p>
            <strong>Pressuposto:</strong> ideia não dita diretamente, mas marcada linguisticamente por uma palavra (advérbio, verbo aspectual como "parou de", "ainda", "tornou-se"). <strong>Subentendido:</strong> insinuação contextual que depende da inferência do leitor nas entrelinhas (muito comum em charges, ironias e propagandas).
          </p>
        </article>

        <article class="card theory-card">
          <h3>4. Intertextualidade e Coesão Referencial</h3>
          <p>
            A <strong>intertextualidade</strong> ocorre quando um texto dialoga com outro texto ou obra de arte prévia (por citação, paráfrase, paródia ou alusão). Já a <strong>coesão referencial</strong> garante a retomada de termos por pronomes, elipses e sinônimos sem ambiguidades.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Banco de Questões Interativas -->
  <section class="section">
    <div class="container">
      <div class="controls-panel card">
        <div class="search-row">
          <label for="search-questoes" class="sr-only">Buscar questão por palavra-chave, autor ou texto</label>
          <input
            type="search"
            id="search-questoes"
            placeholder="Buscar questão por texto, autor, tema ou número (ex.: Drummond, Clarice, variação, inglês, Q15)..."
            class="search-input"
          />
          <div class="actions-bar">
            <span id="questoes-count" class="results-count" aria-live="polite">
              Exibindo {questoes.length} de {questoes.length} questões
            </span>
            <span id="answered-count" class="answered-badge" aria-live="polite">
              0 respondidas
            </span>
            <button
              type="button"
              id="clear-all-selections"
              class="btn btn-secondary btn-sm"
            >
              Limpar seleções
            </button>
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Filtrar por Caderno / Material de Origem:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar questões por caderno ou documento">
            {
              cadernos.map((cad, idx) => (
                <button
                  type="button"
                  class:list={['filter-chip', { active: idx === 0 }]}
                  data-filter-caderno={cad}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {cad}
                </button>
              ))
            }
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Filtrar por Tópico de Linguagens:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar questões por tópico">
            {
              categorias.map((cat, idx) => (
                <button
                  type="button"
                  class:list={['filter-chip', { active: idx === 0 }]}
                  data-filter-cat={cat}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {cat}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="questions-list" id="questions-list">
        {questoes.map((questao, index) => <QuestionCard questao={questao} index={index} />)}
      </div>

      <div id="questoes-empty" class="card empty-state" hidden>
        <h3>Nenhuma questão encontrada para estes filtros</h3>
        <p>Tente limpar o campo de busca ou selecionar "Todos os documentos" e "Todas".</p>
        <button type="button" id="reset-questoes-filters" class="btn btn-secondary">
          Limpar filtros
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const questionCards = document.querySelectorAll<HTMLElement>('.question-card');
  const searchInput = document.getElementById('search-questoes') as HTMLInputElement | null;
  const cadernoBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-caderno]');
  const catBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-cat]');
  const countEl = document.getElementById('questoes-count');
  const answeredEl = document.getElementById('answered-count');
  const clearAllBtn = document.getElementById('clear-all-selections');
  const emptyEl = document.getElementById('questoes-empty');
  const resetFiltersBtn = document.getElementById('reset-questoes-filters');

  const totalQuestions = questionCards.length;
  let activeCaderno = 'Todos os documentos';
  let activeCat = 'Todas';

  function updateAnsweredCounter() {
    let answered = 0;
    questionCards.forEach((card) => {
      if (card.getAttribute('data-answered') === 'true') {
        answered++;
      }
    });
    if (answeredEl) {
      answeredEl.textContent = `${answered} ${answered === 1 ? 'respondida' : 'respondidas'}`;
    }
  }

  function clearCardSelection(card: HTMLElement) {
    card.removeAttribute('data-answered');
    const optionBtns = card.querySelectorAll<HTMLButtonElement>('.q-option-btn');
    const feedbackEl = card.querySelector<HTMLElement>('.q-feedback');
    const detailsEl = card.querySelector<HTMLDetailsElement>('.q-resolution');
    const clearBtn = card.querySelector<HTMLButtonElement>('.q-clear-btn');

    optionBtns.forEach((b) => b.classList.remove('is-correct', 'is-wrong'));
    if (feedbackEl) {
      feedbackEl.setAttribute('hidden', '');
      feedbackEl.textContent = '';
      feedbackEl.className = 'q-feedback';
    }
    if (detailsEl) {
      detailsEl.open = false;
    }
    if (clearBtn) {
      clearBtn.setAttribute('hidden', '');
    }
  }

  // Interatividade de responder ou limpar cada questão no navegador
  questionCards.forEach((card) => {
    const gabarito = card.getAttribute('data-gabarito') || '';
    const optionBtns = card.querySelectorAll<HTMLButtonElement>('.q-option-btn');
    const feedbackEl = card.querySelector<HTMLElement>('.q-feedback');
    const detailsEl = card.querySelector<HTMLDetailsElement>('.q-resolution');
    const clearBtn = card.querySelector<HTMLButtonElement>('.q-clear-btn');

    optionBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const chosen = btn.getAttribute('data-letra') || '';
        card.setAttribute('data-answered', 'true');

        optionBtns.forEach((b) => {
          b.classList.remove('is-correct', 'is-wrong');
          if (b.getAttribute('data-letra') === gabarito) {
            b.classList.add('is-correct');
          }
        });

        if (chosen === gabarito) {
          btn.classList.add('is-correct');
          if (feedbackEl) {
            feedbackEl.removeAttribute('hidden');
            feedbackEl.className = 'q-feedback correct';
            feedbackEl.textContent = `Resposta correta! Alternativa ${gabarito}. Confira o comentário pedagógico abaixo.`;
          }
        } else {
          btn.classList.add('is-wrong');
          if (feedbackEl) {
            feedbackEl.removeAttribute('hidden');
            feedbackEl.className = 'q-feedback wrong';
            feedbackEl.textContent = `Você marcou a alternativa ${chosen}. O gabarito oficial é a alternativa ${gabarito}. Veja a explicação abaixo:`;
          }
        }

        if (detailsEl) {
          detailsEl.open = true;
        }
        if (clearBtn) {
          clearBtn.removeAttribute('hidden');
        }
        updateAnsweredCounter();
      });
    });

    clearBtn?.addEventListener('click', () => {
      clearCardSelection(card);
      updateAnsweredCounter();
    });
  });

  // Botão global: Limpar todas as seleções
  clearAllBtn?.addEventListener('click', () => {
    questionCards.forEach((card) => clearCardSelection(card));
    updateAnsweredCounter();
  });

  // Filtros combinados (Busca + Caderno + Categoria)
  function applyFilters() {
    const q = (searchInput?.value || '')
      .trim()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
    let visible = 0;

    questionCards.forEach((card) => {
      const cardCaderno = card.getAttribute('data-caderno') || '';
      const cardCat = card.getAttribute('data-categoria') || '';
      const cardSearch = card.getAttribute('data-search') || '';

      const matchCaderno =
        activeCaderno === 'Todos os documentos' || cardCaderno === activeCaderno;
      const matchCat = activeCat === 'Todas' || cardCat === activeCat;
      const matchQuery = !q || cardSearch.includes(q);

      if (matchCaderno && matchCat && matchQuery) {
        card.removeAttribute('hidden');
        visible++;
      } else {
        card.setAttribute('hidden', '');
      }
    });

    if (countEl) {
      countEl.textContent = `Exibindo ${visible} de ${totalQuestions} questões`;
    }
    if (emptyEl) {
      if (visible === 0) emptyEl.removeAttribute('hidden');
      else emptyEl.setAttribute('hidden', '');
    }
  }

  cadernoBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCaderno = btn.getAttribute('data-filter-caderno') || 'Todos os documentos';
      cadernoBtns.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('active', isCurrent);
        b.setAttribute('aria-pressed', String(isCurrent));
      });
      applyFilters();
    });
  });

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.getAttribute('data-filter-cat') || 'Todas';
      catBtns.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('active', isCurrent);
        b.setAttribute('aria-pressed', String(isCurrent));
      });
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);

  resetFiltersBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    cadernoBtns[0]?.click();
    catBtns[0]?.click();
  });
</script>

<style>
  .theory-header {
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .theory-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .theory-card h3 {
    font-size: 1.15rem;
    color: var(--color-wine-900);
  }

  .theory-card p {
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .controls-panel {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2rem;
  }

  .search-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .search-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .search-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-cream-300);
    background-color: var(--color-cream-50);
    font-size: var(--text-sm);
  }

  .actions-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .results-count {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-500);
    white-space: nowrap;
  }

  .answered-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-wine-800);
    background-color: var(--color-rose-50);
    border: 1px solid var(--color-rose-200);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .btn-sm {
    padding: 0.45rem 0.95rem;
    font-size: var(--text-xs);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .filter-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-500);
  }

  .questions-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
</style>
