---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import closeIcon from '../../assets/icons/close.svg?raw';
import { getQuestoesComentadas } from '../../utils/content';
import { url } from '../../utils/urls';

const questoes = getQuestoesComentadas().sort((a, b) => {
  const diffAno = (b.ano || 2025) - (a.ano || 2025);
  if (diffAno !== 0) return diffAno;
  return (a.numeroQuestao || 0) - (b.numeroQuestao || 0);
});

const anos = [
  'Todos os anos',
  ...Array.from(new Set(questoes.map((q) => String(q.ano || 2025)))).sort((a, b) => Number(b) - Number(a)),
];

const idiomas = ['Todos os idiomas', 'Português', 'Inglês', 'Espanhol'];

const categorias = [
  'Todas as categorias',
  ...Array.from(new Set(questoes.map((q) => q.categoria))),
];
---

<BaseLayout
  title="Banco de Questões Comentadas"
  description="Consulte o acervo oficial de questões dos últimos 10 anos do ENEM (2016 a 2025) de Linguagens, Códigos e suas Tecnologias comentadas e resolvidas."
>
  <section class="section section-editorial">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Portal ENEM', href: '/' },
          { label: 'Banco de Questões Comentadas' },
        ]}
      />
      <span class="eyebrow">Acervo Oficial para Estudo e Consulta</span>
      <h1>Banco de Questões Comentadas de Linguagens</h1>
      <p class="lead" style="max-width: 68ch; margin-top: 0.75rem;">
        Consulte as questões oficiais do ENEM (2016 a 2025) da área de <strong>Linguagens, Códigos e suas Tecnologias</strong>. Todas as questões acompanham transcrição integral, reprodução de figuras e cartazes, gabarito oficial do INEP e resolução pedagógica comentada.
      </p>
    </div>
  </section>

  <!-- Resumos Rápidos de Teoria -->
  <section class="section section-cream">
    <div class="container">
      <div class="theory-header">
        <span class="eyebrow">Sínteses de Revisão Rápida</span>
        <h2>Tópicos Mais Cobrados em Linguagens no ENEM</h2>
      </div>

      <div class="grid-2">
        <article class="card theory-card">
          <h3>1. Variação Linguística vs. Norma-Padrão</h3>
          <p>
            O ENEM avalia a língua sob a perspectiva sociolinguística: não existe variedade "certa" ou "errada" em absoluto, mas <strong>adequação à situação comunicativa e ao gênero textual</strong>. As variações podem ser regionais/geográficas (diatópicas), sociais (diastráticas), históricas (diacrônicas) ou de registro/estilo (diafásicas).
          </p>
        </article>

        <article class="card theory-card">
          <h3>2. As 6 Funções da Linguagem</h3>
          <p>
            <strong>Referencial:</strong> foco no contexto/informação objetiva (jornalismo). <strong>Emotiva:</strong> foco no emissor/1ª pessoa. <strong>Conativa/Apelativa:</strong> foco no receptor/verbos no imperativo (publicidade). <strong>Poética:</strong> foco na elaboração estética da mensagem. <strong>Fática:</strong> foco no canal de contato. <strong>Metalinguística:</strong> o código explicando o próprio código.
          </p>
        </article>

        <article class="card theory-card">
          <h3>3. Informações Implícitas: Pressupostos e Subentendidos</h3>
          <p>
            <strong>Pressuposto:</strong> ideia não dita diretamente, mas marcada linguisticamente por uma palavra (advérbio, verbo aspectual como "parou de", "ainda", "tornou-se"). <strong>Subentendido:</strong> insinuação contextual que depende da inferência do leitor nas entrelinhas (muito comum em charges, ironias e propagandas).
          </p>
        </article>

        <article class="card theory-card">
          <h3>4. Intertextualidade e Coesão Referencial</h3>
          <p>
            A <strong>intertextualidade</strong> ocorre quando um texto dialoga com outro texto ou obra de arte prévia (por citação, paráfrase, paródia ou alusão). Já a <strong>coesão referencial</strong> garante a retomada de termos por pronomes, elipses e sinônimos sem ambiguidades.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Banco de Questões de Consulta com Paginação e Filtros Interdependentes -->
  <section class="section" id="secao-banco-questoes">
    <div class="container">
      <div class="controls-panel card">
        <div class="search-row">
          <label for="search-questoes" class="sr-only">Buscar questão por palavra-chave, autor ou texto</label>
          <input
            type="search"
            id="search-questoes"
            placeholder="Buscar por palavra-chave, autor, obra, tema ou número (ex.: Drummond, Clarice, variação, inglês, Q15)..."
            class="search-input"
          />
          <div class="actions-bar">
            <span id="questoes-count" class="results-count" aria-live="polite">
              Carregando questões...
            </span>
            <label for="select-page-size" class="page-size-label">
              Por página:
              <div class="select-wrapper select-wrapper-compact">
                <select id="select-page-size" class="form-select-editorial form-select-compact">
                  <option value="15" selected>15</option>
                  <option value="30">30</option>
                  <option value="50">50</option>
                </select>
              </div>
            </label>
            <button
              type="button"
              id="reset-questoes-filters"
              class="btn btn-secondary btn-sm"
            >
              Limpar filtros
            </button>
          </div>
        </div>

        <!-- Filtro por Ano -->
        <div class="filter-group">
          <span class="filter-label">Ano da Prova:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar questões por ano do ENEM">
            {
              anos.map((ano, idx) => (
                <button
                  type="button"
                  class:list={['filter-chip', { active: idx === 0 }]}
                  data-filter-ano={ano}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {ano}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Filtro por Idioma -->
        <div class="filter-group">
          <span class="filter-label">Idioma da Questão:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar questões por idioma">
            {
              idiomas.map((idioma, idx) => (
                <button
                  type="button"
                  class:list={['filter-chip', { active: idx === 0 }]}
                  data-filter-idioma={idioma}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {idioma}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Filtro por Categoria -->
        <div class="filter-group">
          <span class="filter-label">Tópico de Linguagens:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar questões por categoria temática">
            {
              categorias.map((cat, idx) => (
                <button
                  type="button"
                  class:list={['filter-chip', { active: idx === 0 }]}
                  data-filter-cat={cat}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {cat}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Barra de Paginação Superior -->
      <nav id="pagination-top" class="pagination-bar" aria-label="Paginação superior das questões"></nav>

      <!-- Lista Paginada de Questões -->
      <div class="questions-list" id="questions-list"></div>

      <!-- Barra de Paginação Inferior -->
      <nav id="pagination-bottom" class="pagination-bar" aria-label="Paginação inferior das questões"></nav>

      <div id="questoes-empty" class="card empty-state" hidden>
        <h3>Nenhuma questão encontrada para estes filtros</h3>
        <p>Tente ajustar o termo de pesquisa ou restaurar os filtros de ano, idioma e categoria.</p>
        <button type="button" id="reset-questoes-filters-empty" class="btn btn-secondary">
          Restaurar filtros
        </button>
      </div>
    </div>
  </section>

  <!-- Card Pequeno Flutuante convidando para o Simulado -->
  <aside
    id="floating-simulado-card"
    class="floating-simulado-card"
    aria-label="Convite para o Simulado ENEM Online"
  >
    <button
      type="button"
      id="close-floating-simulado"
      class="floating-close-btn"
      aria-label="Fechar convite do simulado"
      title="Fechar"
    >
      <Fragment set:html={closeIcon} />
    </button>
    <div class="floating-badge">⏱️ Ambiente de Prova</div>
    <p class="floating-title">Quer treinar no Simulado?</p>
    <p class="floating-desc">
      Resolva provas por ano ou 45 questões aleatórias com cronômetro.
    </p>
    <a href={url('/enem/simulado')} class="btn btn-primary btn-xs floating-cta">
      Fazer Simulado →
    </a>
  </aside>

  <!-- Dados serializados para paginação e filtragem instantânea -->
  <script id="banco-questoes-data" type="application/json" set:html={JSON.stringify(questoes)} />
</BaseLayout>

<script>
  interface Alternativa {
    letra: string;
    texto: string;
  }

  interface QuestaoImagem {
    arquivo: string;
    alt: string;
  }

  interface QuestaoOcorrencia {
    cor: string;
    numeroQuestao: number;
  }

  interface Questao {
    id: string;
    ano?: number;
    cor?: string;
    numeroQuestao?: number;
    caderno?: string;
    idioma?: string;
    origem: string;
    categoria: string;
    habilidade: string;
    titulo: string;
    textoBase: string;
    referenciaTexto: string;
    enunciado: string;
    alternativas: Alternativa[];
    gabarito: string;
    comentarioPedagogico: string;
    imagens?: QuestaoImagem[];
    ocorrencias?: QuestaoOcorrencia[];
    _idioma?: string;
    _search?: string;
  }

  function detectIdioma(q: Questao): string {
    const ref = `${q.categoria} ${q.origem} ${q.id}`.toLowerCase();
    if (ref.includes('ingl')) return 'Inglês';
    if (ref.includes('espan')) return 'Espanhol';
    return 'Português';
  }

  function normalizeStr(str: string): string {
    return str
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Carregar dados, ordenar por ano decrescente e indexar texto de busca uma única vez
  const rawData = JSON.parse(document.getElementById('banco-questoes-data')?.textContent || '[]') as Questao[];
  const allQuestions: Questao[] = rawData
    .map((q) => {
      const idioma = detectIdioma(q);
      return {
        ...q,
        _idioma: idioma,
        _search: normalizeStr(
          `${q.id} ${q.titulo} ${q.categoria} ${idioma} ${q.textoBase} ${q.enunciado} ${q.ano || ''} q${q.numeroQuestao || ''}`
        ),
      };
    })
    .sort((a, b) => {
      const diffAno = (b.ano || 2025) - (a.ano || 2025);
      if (diffAno !== 0) return diffAno;
      return (a.numeroQuestao || 0) - (b.numeroQuestao || 0);
    });

  // Elementos do DOM
  const searchInput = document.getElementById('search-questoes') as HTMLInputElement | null;
  const pageSizeSelect = document.getElementById('select-page-size') as HTMLSelectElement | null;
  const anoBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-ano]'));
  const idiomaBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-idioma]'));
  const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-cat]'));
  const countEl = document.getElementById('questoes-count');
  const listEl = document.getElementById('questions-list');
  const pagTopEl = document.getElementById('pagination-top');
  const pagBottomEl = document.getElementById('pagination-bottom');
  const emptyEl = document.getElementById('questoes-empty');
  const resetFiltersBtn = document.getElementById('reset-questoes-filters');
  const resetFiltersBtnEmpty = document.getElementById('reset-questoes-filters-empty');

  // Card flutuante
  const floatingCard = document.getElementById('floating-simulado-card');
  const closeFloatingBtn = document.getElementById('close-floating-simulado');

  closeFloatingBtn?.addEventListener('click', () => {
    floatingCard?.setAttribute('hidden', '');
  });

  // Estado ativo
  let activeAno = 'Todos os anos';
  let activeIdioma = 'Todos os idiomas';
  let activeCat = 'Todas as categorias';
  let currentPage = 1;
  let pageSize = Number(pageSizeSelect?.value || 15);
  let filteredQuestions: Questao[] = [];

  function matchesQuestion(
    q: Questao,
    anoFilter: string,
    idiomaFilter: string,
    catFilter: string,
    query: string
  ): boolean {
    const qAno = String(q.ano || 2025);
    const qIdioma = q.idioma || q._idioma || 'Português';
    const qCat = q.categoria;

    const matchAno = anoFilter === 'Todos os anos' || qAno === anoFilter;
    const matchIdioma = idiomaFilter === 'Todos os idiomas' || qIdioma === idiomaFilter;
    const matchCat = catFilter === 'Todas as categorias' || qCat === catFilter;
    const matchQuery = !query || (q._search ? q._search.includes(query) : false);

    return matchAno && matchIdioma && matchCat && matchQuery;
  }

  // Atualizar visibilidade cruzada (cross-filtering) entre Ano, Idioma, Categoria e Busca
  function updateCrossFilters(query: string) {
    // 1. Verificar quais Anos possuem questões compatíveis com (activeIdioma, activeCat, query)
    anoBtns.forEach((btn) => {
      const val = btn.getAttribute('data-filter-ano') || 'Todos os anos';
      if (val === 'Todos os anos') {
        btn.hidden = false;
        return;
      }
      const hasMatch = allQuestions.some((q) =>
        matchesQuestion(q, val, activeIdioma, activeCat, query)
      );
      btn.hidden = !hasMatch;
    });

    const currentAnoBtn = anoBtns.find((b) => b.getAttribute('data-filter-ano') === activeAno);
    if (currentAnoBtn && currentAnoBtn.hidden) {
      activeAno = 'Todos os anos';
      syncChipActiveState(anoBtns, 'data-filter-ano', activeAno);
    }

    // 2. Verificar quais Idiomas possuem questões compatíveis com (activeAno, activeCat, query)
    idiomaBtns.forEach((btn) => {
      const val = btn.getAttribute('data-filter-idioma') || 'Todos os idiomas';
      if (val === 'Todos os idiomas') {
        btn.hidden = false;
        return;
      }
      const hasMatch = allQuestions.some((q) =>
        matchesQuestion(q, activeAno, val, activeCat, query)
      );
      btn.hidden = !hasMatch;
    });

    const currentIdiomaBtn = idiomaBtns.find((b) => b.getAttribute('data-filter-idioma') === activeIdioma);
    if (currentIdiomaBtn && currentIdiomaBtn.hidden) {
      activeIdioma = 'Todos os idiomas';
      syncChipActiveState(idiomaBtns, 'data-filter-idioma', activeIdioma);
    }

    // 3. Verificar quais Categorias possuem questões compatíveis com (activeAno, activeIdioma, query)
    catBtns.forEach((btn) => {
      const val = btn.getAttribute('data-filter-cat') || 'Todas as categorias';
      if (val === 'Todas as categorias') {
        btn.hidden = false;
        return;
      }
      const hasMatch = allQuestions.some((q) =>
        matchesQuestion(q, activeAno, activeIdioma, val, query)
      );
      btn.hidden = !hasMatch;
    });

    const currentCatBtn = catBtns.find((b) => b.getAttribute('data-filter-cat') === activeCat);
    if (currentCatBtn && currentCatBtn.hidden) {
      activeCat = 'Todas as categorias';
      syncChipActiveState(catBtns, 'data-filter-cat', activeCat);
    }

    // Re-atualizar Anos e Idiomas caso algum filtro tenha sido auto-resetado
    anoBtns.forEach((btn) => {
      const val = btn.getAttribute('data-filter-ano') || 'Todos os anos';
      if (val === 'Todos os anos') return;
      btn.hidden = !allQuestions.some((q) =>
        matchesQuestion(q, val, activeIdioma, activeCat, query)
      );
    });
    idiomaBtns.forEach((btn) => {
      const val = btn.getAttribute('data-filter-idioma') || 'Todos os idiomas';
      if (val === 'Todos os idiomas') return;
      btn.hidden = !allQuestions.some((q) =>
        matchesQuestion(q, activeAno, val, activeCat, query)
      );
    });
  }

  function syncChipActiveState(btns: HTMLButtonElement[], attr: string, activeVal: string) {
    btns.forEach((b) => {
      const isCurrent = b.getAttribute(attr) === activeVal;
      b.classList.toggle('active', isCurrent);
      b.setAttribute('aria-pressed', String(isCurrent));
    });
  }

  // Renderizar um Card de Questão em HTML
  function renderQuestionCardHtml(questao: Questao, globalIndex: number): string {
    const anoBadge = questao.ano
      ? `<span class="badge badge-wine">ENEM ${questao.ano}</span>`
      : '';
    const numBadge = questao.numeroQuestao
      ? `<span class="badge badge-slate">Questão ${String(questao.numeroQuestao).padStart(2, '0')}</span>`
      : '';

    const altsHtml = questao.alternativas
      .map(
        (alt) => `
        <li class="q-option-item">
          <span class="q-opt-letter">${escapeHtml(alt.letra)}</span>
          <span class="q-opt-text">${escapeHtml(alt.texto)}</span>
        </li>
      `
      )
      .join('');

    const imagensHtml =
      questao.imagens && questao.imagens.length > 0
        ? `<div class="q-images-container" style="display: flex; flex-direction: column; gap: 1rem; margin: 1.25rem 0; align-items: center;">
            ${questao.imagens
              .map(
                (img) => `
                <figure style="margin: 0; max-width: 100%; text-align: center;">
                  <img src="/assets/questoes/${escapeHtml(img.arquivo)}" alt="${escapeHtml(img.alt)}" style="max-width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--color-cream-300); box-shadow: 0 2px 8px rgba(0,0,0,0.06);" loading="lazy" />
                  ${img.alt ? `<figcaption style="font-size: 0.8rem; color: var(--color-slate-600); margin-top: 0.35rem; font-style: italic;">${escapeHtml(img.alt)}</figcaption>` : ''}
                </figure>
              `
              )
              .join('')}
          </div>`
        : '';

    const formattedTextBase = escapeHtml(questao.textoBase)
      .split('\n\n')
      .map((p) => `<p style="margin-bottom: 0.75rem;">${p.replace(/\n/g, '<br />')}</p>`)
      .join('');

    return `
      <article class="card question-card" id="${escapeHtml(questao.id)}">
        <div class="q-header">
          <div class="q-badges">
            ${anoBadge}
            ${numBadge}
            <span class="badge badge-rose">${escapeHtml(questao.categoria)}</span>
          </div>
          <div class="q-header-right">
            <span class="q-skill">${escapeHtml(questao.habilidade)}</span>
          </div>
        </div>

        <h3 class="q-title">
          <span class="q-num">#${String(globalIndex + 1).padStart(2, '0')}</span>
          ${escapeHtml(questao.titulo)}
        </h3>

        <div class="q-support-text">
          ${imagensHtml}
          ${formattedTextBase}
          <cite>${escapeHtml(questao.referenciaTexto)}</cite>
        </div>

        <p class="q-statement">${escapeHtml(questao.enunciado)}</p>

        <ul class="q-options-list" role="list">
          ${altsHtml}
        </ul>

        <details class="q-resolution">
          <summary>Ver gabarito oficial e comentário pedagógico</summary>
          <div class="q-resolution-body">
            <p class="q-answer-badge">
              Gabarito Oficial: <strong>Alternativa ${escapeHtml(questao.gabarito)}</strong>
            </p>
            <p class="q-commentary">${escapeHtml(questao.comentarioPedagogico)}</p>
          </div>
        </details>
      </article>
    `;
  }

  // Construir barra de paginação
  function buildPaginationHtml(totalPages: number, totalItems: number, startIdx: number, endIdx: number): string {
    if (totalPages <= 1) return '';

    const pages: (number | string)[] = [];
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) {
        pages.push(p);
      } else if (pages[pages.length - 1] !== '...') {
        pages.push('...');
      }
    }

    const pageBtns = pages
      .map((p) => {
        if (p === '...') {
          return `<span class="pag-ellipsis">…</span>`;
        }
        const isCurrent = p === currentPage;
        return `<button type="button" class="pag-btn ${isCurrent ? 'active' : ''}" data-page="${p}" ${
          isCurrent ? 'aria-current="page"' : ''
        }>${p}</button>`;
      })
      .join('');

    return `
      <div class="pag-info">
        Página <strong>${currentPage}</strong> de <strong>${totalPages}</strong>
        <span class="pag-sep">•</span>
        Mostrando <strong>${startIdx + 1}–${endIdx}</strong> de <strong>${totalItems}</strong> questões
      </div>
      <div class="pag-controls">
        <button type="button" class="pag-btn pag-nav" data-page="${currentPage - 1}" ${
          currentPage === 1 ? 'disabled' : ''
        }>
          ← Anterior
        </button>
        <div class="pag-numbers">${pageBtns}</div>
        <button type="button" class="pag-btn pag-nav" data-page="${currentPage + 1}" ${
          currentPage === totalPages ? 'disabled' : ''
        }>
          Próxima →
        </button>
      </div>
    `;
  }

  function renderCurrentPage(scrollToTop = false) {
    const totalItems = filteredQuestions.length;
    const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIdx = (currentPage - 1) * pageSize;
    const endIdx = Math.min(startIdx + pageSize, totalItems);
    const pageSlice = filteredQuestions.slice(startIdx, endIdx);

    if (countEl) {
      countEl.textContent =
        totalItems > 0
          ? `Exibindo ${startIdx + 1}–${endIdx} de ${totalItems} questões filtradas`
          : `0 questões encontradas`;
    }

    if (listEl) {
      if (totalItems === 0) {
        listEl.innerHTML = '';
      } else {
        listEl.innerHTML = pageSlice
          .map((q, idx) => renderQuestionCardHtml(q, startIdx + idx))
          .join('');
      }
    }

    const pagHtml = totalItems > 0 ? buildPaginationHtml(totalPages, totalItems, startIdx, endIdx) : '';
    if (pagTopEl) pagTopEl.innerHTML = pagHtml;
    if (pagBottomEl) pagBottomEl.innerHTML = pagHtml;

    if (emptyEl) {
      if (totalItems === 0) emptyEl.removeAttribute('hidden');
      else emptyEl.setAttribute('hidden', '');
    }

    if (scrollToTop) {
      document.getElementById('secao-banco-questoes')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function applyFilters() {
    const q = normalizeStr((searchInput?.value || '').trim());

    // Atualizar opções disponíveis nos filtros entre si
    updateCrossFilters(q);

    // Filtrar questões
    filteredQuestions = allQuestions.filter((item) =>
      matchesQuestion(item, activeAno, activeIdioma, activeCat, q)
    );

    currentPage = 1;
    renderCurrentPage(false);
  }

  // Delegação de clique para paginação
  function handlePaginationClick(e: Event) {
    const target = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
    if (!target || target.disabled) return;
    const newPage = Number(target.getAttribute('data-page'));
    if (newPage && newPage !== currentPage) {
      currentPage = newPage;
      renderCurrentPage(true);
    }
  }

  pagTopEl?.addEventListener('click', handlePaginationClick);
  pagBottomEl?.addEventListener('click', handlePaginationClick);

  anoBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeAno = btn.getAttribute('data-filter-ano') || 'Todos os anos';
      syncChipActiveState(anoBtns, 'data-filter-ano', activeAno);
      applyFilters();
    });
  });

  idiomaBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeIdioma = btn.getAttribute('data-filter-idioma') || 'Todos os idiomas';
      syncChipActiveState(idiomaBtns, 'data-filter-idioma', activeIdioma);
      applyFilters();
    });
  });

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.getAttribute('data-filter-cat') || 'Todas as categorias';
      syncChipActiveState(catBtns, 'data-filter-cat', activeCat);
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);

  pageSizeSelect?.addEventListener('change', () => {
    pageSize = Number(pageSizeSelect.value || 15);
    currentPage = 1;
    renderCurrentPage(false);
  });

  function resetAll() {
    if (searchInput) searchInput.value = '';
    activeAno = 'Todos os anos';
    activeIdioma = 'Todos os idiomas';
    activeCat = 'Todas as categorias';
    syncChipActiveState(anoBtns, 'data-filter-ano', activeAno);
    syncChipActiveState(idiomaBtns, 'data-filter-idioma', activeIdioma);
    syncChipActiveState(catBtns, 'data-filter-cat', activeCat);
    applyFilters();
  }

  resetFiltersBtn?.addEventListener('click', resetAll);
  resetFiltersBtnEmpty?.addEventListener('click', resetAll);

  // Inicialização imediata
  applyFilters();
</script>

