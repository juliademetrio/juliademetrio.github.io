---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import RepertoireCard from '../../components/enem/RepertoireCard.astro';
import closeIcon from '../../assets/icons/close.svg?raw';
import { getRepertorio } from '../../utils/content';
import { EIXOS_LIST } from '../../utils/eixos';

const repertorio = getRepertorio();
const tipos = [
  { label: 'Todos os tipos', value: 'todos' },
  { label: 'Livros', value: 'Livro' },
  { label: 'Filmes e Séries', value: 'Filme / Série' },
  { label: 'Documentários', value: 'Documentário' },
  { label: 'Filósofos e Sociólogos', value: 'Filósofo / Sociólogo' },
  { label: 'Leis e Estudos', value: 'Lei / Documento' },
];
---

<BaseLayout
  title="Banco de Repertório"
  description="Catálogo de livros, filmes, documentários, filósofos, sociólogos e leis organizados por eixo temático, com explicação prática de como usar na redação do ENEM."
>
  <section class="section section-editorial">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Portal ENEM', href: '/' },
          { label: 'Banco de Repertório' },
        ]}
      />
      <span class="eyebrow">Competência 2 da Redação</span>
      <h1>Banco de Repertório Sociocultural</h1>
      <p class="lead" style="max-width: 68ch; margin-top: 0.75rem;">
        Explore <strong>{repertorio.length} referências legitimadas</strong> — entre livros clássicos e contemporâneos, filmes, documentários, pensadores e marcos legais — com orientação direta de aplicação nos parágrafos da dissertação.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Disclaimer de Fonte Pedagógica & Créditos Institucionais IFMG -->
      <div class="credits-disclaimer-card card">
        <div class="disclaimer-body">
          <div class="disclaimer-header">
            <span class="badge badge-gold">Fonte Pedagógica de Referência</span>
            <span class="disclaimer-inst">IFMG • Campus Ribeirão das Neves / Campus Ibirité</span>
          </div>
          <p class="disclaimer-text">
            Este banco de repertórios socioculturais foi fundamentado na coletânea acadêmica <em>"Rumo à Nota Mil: Repertórios para Redação do Enem"</em>, produzida por docentes e pesquisadores do <strong>Instituto Federal de Minas Gerais (IFMG)</strong>.
          </p>
        </div>
        <button
          type="button"
          class="btn btn-secondary btn-sm disclaimer-btn"
          id="open-credits-btn"
          aria-haspopup="dialog"
          aria-controls="credits-dialog"
        >
          Ver Autores & Créditos
        </button>
      </div>

      <div class="controls-panel card">
        <div class="search-row">
          <label for="search-rep" class="sr-only">Buscar repertório</label>
          <input
            type="search"
            id="search-rep"
            placeholder="Buscar por obra, autor, filósofo, lei ou tema (ex.: Bauman, Krenak, Constituição, Vidas Secas)..."
            class="search-input"
          />
          <span id="rep-count" class="results-count" aria-live="polite">
            Exibindo {repertorio.length} repertórios
          </span>
        </div>

        <div class="filter-group">
          <span class="filter-label">Tipo de Repertório:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar por tipo de repertório">
            {
              tipos.map((t, idx) => (
                <button
                  type="button"
                  class:list={['filter-chip', { active: idx === 0 }]}
                  data-filter-tipo={t.value}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  {t.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Eixo Temático:</span>
          <div class="filter-bar filter-bar-scroll" role="group" aria-label="Filtrar por eixo temático">
            <button type="button" class="filter-chip active" data-filter-eixo="todos" aria-pressed="true">
              Todos os eixos
            </button>
            {
              EIXOS_LIST.map((eixo) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter-eixo={eixo.slug}
                  aria-pressed="false"
                >
                  {eixo.shortLabel}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="grid-3" id="rep-grid">
        {repertorio.map((item) => <RepertoireCard item={item} />)}
      </div>

      <div id="rep-empty" class="card empty-state" hidden>
        <h3>Nenhum repertório encontrado para esta combinação</h3>
        <p>Tente limpar o campo de busca ou selecionar "Todos os tipos" e "Todos os eixos".</p>
        <button type="button" id="reset-rep-filters" class="btn btn-secondary">
          Limpar filtros
        </button>
      </div>
    </div>
  </section>

  <!-- Modal Acessível de Créditos Institucionais IFMG -->
  <dialog class="credits-dialog" id="credits-dialog" aria-labelledby="modal-credits-title">
    <div class="modal-dialog-panel">
      <div class="modal-header">
        <div>
          <span class="badge badge-rose">Créditos Institucionais & Autoria</span>
          <h2 id="modal-credits-title">Rumo à Nota Mil: Repertórios para Redação do Enem</h2>
        </div>
        <button type="button" class="modal-close-btn" id="close-credits-btn" aria-label="Fechar janela de créditos">
          <Fragment set:html={closeIcon} />
        </button>
      </div>

      <div class="modal-body">
        <p class="modal-intro">
          Reconhecimento à equipe de professores, pesquisadores e estudantes do <strong>Instituto Federal de Educação, Ciência e Tecnologia de Minas Gerais (IFMG — Campus Ribeirão das Neves / Campus Ibirité)</strong> responsáveis pela autoria, pesquisa e organização do e-book:
        </p>

        <ul class="authors-list">
          <li class="author-item">
            <strong>Profa. Dra. Gláucia do Carmo Xavier</strong>
            <span>Coordenadora do Projeto • Professora Titular no IFMG • Doutora em Estudos Linguísticos (UFMG) e Pós-Doutora em Psicolinguística Experimental (UFMG)</span>
          </li>
          <li class="author-item">
            <strong>Heloisa Vieira de Lima</strong>
            <span>Bolsista do projeto Redação do Enem • Formada em Administração pelo IFMG • Graduanda na UFMG</span>
          </li>
          <li class="author-item">
            <strong>Samilly Esther Caetano Gomes (Samilly Andrade Irias)</strong>
            <span>Bolsista do projeto Redação do Enem • Formada pelo IFMG</span>
          </li>
          <li class="author-item">
            <strong>Thalyta Flávio Silveira Rodrigues</strong>
            <span>Monitora de redação do projeto • Graduanda em Ciências Contábeis na UFMG • Formada pelo IFMG</span>
          </li>
          <li class="author-item">
            <strong>Ana Luiza Soares Almeida</strong>
            <span>Bolsista do projeto Redação do Enem • Técnica em Automação Industrial pelo IFMG (Campus Ibirité)</span>
          </li>
          <li class="author-item">
            <strong>Caio Saylon Pereira Lima</strong>
            <span>Bolsista PIBIC Jr. • IFMG — Campus Ribeirão das Neves</span>
          </li>
          <li class="author-item">
            <strong>Giovanna Martins de Andrade Irias</strong>
            <span>Bolsista PIBIC Jr. • Técnica em Administração pelo IFMG</span>
          </li>
        </ul>

        <div class="modal-source-box">
          <strong>Acesso ao Documento Oficial:</strong>
          <p>
            O e-book completo e gratuito está disponível publicamente para download no portal institucional do IFMG.
          </p>
          <a
            href="https://www.ifmg.edu.br/portal/noticias/rumo-a-nota-1-000/rumo-a-nota-mil-repertorios-para-a-redacao-do-enem_vf.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary modal-cta-btn"
          >
            Acessar Documento no Portal do IFMG (PDF)
          </a>
        </div>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-rep') as HTMLInputElement | null;
  const tipoBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-tipo]');
  const eixoBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-eixo]');
  const cards = document.querySelectorAll<HTMLElement>('.repertoire-card');
  const countEl = document.getElementById('rep-count');
  const emptyEl = document.getElementById('rep-empty');
  const resetBtn = document.getElementById('reset-rep-filters');

  let activeTipo = 'todos';
  let activeEixo = 'todos';

  function applyFilters() {
    const q = (searchInput?.value || '')
      .trim()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const cardTipo = card.getAttribute('data-tipo') || '';
      const cardEixos = (card.getAttribute('data-eixos') || '').split(',');
      const cardSearch = card.getAttribute('data-search') || '';

      const matchTipo = activeTipo === 'todos' || cardTipo === activeTipo;
      const matchEixo = activeEixo === 'todos' || cardEixos.includes(activeEixo);
      const matchQuery = !q || cardSearch.includes(q);

      if (matchTipo && matchEixo && matchQuery) {
        card.removeAttribute('hidden');
        visible++;
      } else {
        card.setAttribute('hidden', '');
      }
    });

    if (countEl) {
      countEl.textContent = `Exibindo ${visible} ${visible === 1 ? 'repertório' : 'repertórios'}`;
    }
    if (emptyEl) {
      if (visible === 0) emptyEl.removeAttribute('hidden');
      else emptyEl.setAttribute('hidden', '');
    }
  }

  tipoBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTipo = btn.getAttribute('data-filter-tipo') || 'todos';
      tipoBtns.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('active', isCurrent);
        b.setAttribute('aria-pressed', String(isCurrent));
      });
      applyFilters();
    });
  });

  eixoBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeEixo = btn.getAttribute('data-filter-eixo') || 'todos';
      eixoBtns.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('active', isCurrent);
        b.setAttribute('aria-pressed', String(isCurrent));
      });
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    tipoBtns[0]?.click();
    eixoBtns[0]?.click();
  });

  // Suporte a ?eixo=slug na URL
  const params = new URLSearchParams(window.location.search);
  const eixoParam = params.get('eixo');
  if (eixoParam) {
    const targetBtn = document.querySelector<HTMLButtonElement>(`[data-filter-eixo="${eixoParam}"]`);
    targetBtn?.click();
  }

  // Controle do Modal de Créditos IFMG
  const creditsDialog = document.getElementById('credits-dialog') as HTMLDialogElement | null;
  const openCreditsBtn = document.getElementById('open-credits-btn');
  const closeCreditsBtn = document.getElementById('close-credits-btn');

  openCreditsBtn?.addEventListener('click', () => {
    creditsDialog?.showModal();
    document.body.style.overflow = 'hidden';
  });

  function closeCreditsModal() {
    creditsDialog?.close();
    document.body.style.overflow = '';
  }

  closeCreditsBtn?.addEventListener('click', closeCreditsModal);

  creditsDialog?.addEventListener('click', (e) => {
    if (e.target === creditsDialog) {
      closeCreditsModal();
    }
  });

  creditsDialog?.addEventListener('cancel', () => {
    document.body.style.overflow = '';
  });
</script>

<style>
  .controls-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .search-row {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  @media (min-width: 768px) {
    .search-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .search-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-cream-300);
    background-color: var(--color-cream-50);
    font-size: var(--text-sm);
  }

  .results-count {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-500);
    white-space: nowrap;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .filter-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-500);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* Disclaimer Institucional IFMG */
  .credits-disclaimer-card {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-cream-100);
    border-left: 4px solid var(--color-gold-500);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .credits-disclaimer-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .disclaimer-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-width: 76ch;
  }

  .disclaimer-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .disclaimer-inst {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-wine-900);
  }

  .disclaimer-text {
    font-size: var(--text-sm);
    color: var(--color-ink-700);
    line-height: 1.5;
  }

  .disclaimer-btn {
    white-space: nowrap;
    align-self: flex-start;
  }

  @media (min-width: 768px) {
    .disclaimer-btn {
      align-self: center;
    }
  }

  /* Modal de Créditos */
  .credits-dialog {
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    max-width: min(92vw, 680px);
    width: 100%;
    background-color: var(--color-cream-50);
    box-shadow: var(--shadow-lg);
    margin: auto;
  }

  .credits-dialog::backdrop {
    background-color: rgba(31, 26, 28, 0.65);
    backdrop-filter: blur(4px);
  }

  .modal-dialog-panel {
    display: flex;
    flex-direction: column;
    max-height: min(88vh, 760px);
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.5rem 1.5rem 1rem;
    border-bottom: 1px solid var(--color-cream-300);
    gap: 1rem;
    background-color: var(--color-cream-100);
  }

  .modal-header h2 {
    font-size: 1.25rem;
    color: var(--color-wine-900);
    margin-top: 0.35rem;
    line-height: 1.3;
  }

  .modal-close-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-cream-300);
    background-color: var(--color-cream-50);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-ink-700);
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .modal-close-btn:hover {
    background-color: var(--color-rose-50);
    color: var(--color-wine-900);
  }

  .modal-body {
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modal-intro {
    font-size: var(--text-sm);
    color: var(--color-ink-700);
    line-height: 1.55;
  }

  .authors-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    list-style: none;
    padding: 0;
  }

  .author-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 1rem;
    background-color: var(--color-cream-100);
    border-left: 3px solid var(--color-wine-800);
    border-radius: var(--radius-sm);
  }

  .author-item strong {
    font-size: var(--text-sm);
    color: var(--color-wine-900);
  }

  .author-item span {
    font-size: var(--text-xs);
    color: var(--color-ink-600);
    line-height: 1.4;
  }

  .modal-source-box {
    margin-top: 0.5rem;
    padding: 1.25rem;
    background-color: var(--color-rose-50);
    border: 1px solid var(--color-rose-200);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .modal-source-box strong {
    font-size: var(--text-sm);
    color: var(--color-wine-900);
  }

  .modal-source-box p {
    font-size: var(--text-xs);
    color: var(--color-ink-700);
    line-height: 1.45;
  }

  .modal-cta-btn {
    margin-top: 0.25rem;
  }
</style>
