  // ============================================================================
  // MODAL DE ZOOM DE IMAGEM
  // ============================================================================
  function updateZoomTransform() {
    if (!zoomModalImg || !zoomLevelIndicator) return;
    zoomModalImg.style.transform = `scale(${currentZoomLevel})`;
    zoomLevelIndicator.textContent = `${Math.round(currentZoomLevel * 100)}%`;
  }

  function setZoomLevel(level: number) {
    currentZoomLevel = Math.min(3.0, Math.max(0.5, Number(level.toFixed(2))));
    updateZoomTransform();
  }

  function openZoomModal(src: string, alt: string) {
    if (!imageZoomModal || !zoomModalImg) return;
    zoomModalImg.src = src;
    zoomModalImg.alt = alt || 'Imagem da questão ampliada';
    if (zoomModalCaption) {
      zoomModalCaption.textContent = alt || '';
      zoomModalCaption.style.display = alt ? 'block' : 'none';
    }
    currentZoomLevel = 1;
    updateZoomTransform();
    imageZoomModal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeZoomModal() {
    if (!imageZoomModal) return;
    imageZoomModal.setAttribute('hidden', '');
    if (zoomModalImg) zoomModalImg.src = '';
    document.body.style.overflow = '';
  }

  btnZoomIn?.addEventListener('click', () => setZoomLevel(currentZoomLevel + 0.25));
  btnZoomOut?.addEventListener('click', () => setZoomLevel(currentZoomLevel - 0.25));
  btnZoomReset?.addEventListener('click', () => setZoomLevel(1));
  btnCloseZoomModal?.addEventListener('click', closeZoomModal);
  zoomModalBackdrop?.addEventListener('click', closeZoomModal);

  zoomModalStage?.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.25 : -0.25;
      setZoomLevel(currentZoomLevel + delta);
    },
    { passive: false }
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && imageZoomModal && !imageZoomModal.hasAttribute('hidden')) {
      closeZoomModal();
    }
  });

  // Delegação de clique para miniaturas de imagem no simulado e na revisão
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('.simulado-img-thumb-btn') as HTMLElement | null;
    if (trigger) {
      const src = trigger.getAttribute('data-zoom-src') || '';
      const alt = trigger.getAttribute('data-zoom-alt') || '';
      if (src) openZoomModal(src, alt);
    }
  });

  // ============================================================================
  // PERSISTÊNCIA NO LOCALSTORAGE (Simulados Recentes)
  // ============================================================================
  function getSavedSimulados(): SavedSimuladoRecord[] {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function saveSimuladosList(list: SavedSimuladoRecord[]) {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, MAX_SAVED_SIMULADOS)));
    } catch {
      // Ignorar caso quota do navegador esteja cheia
    }
  }

  function persistCurrentSimulado(status: 'em_andamento' | 'concluido' = 'em_andamento', acertosCount?: number) {
    if (!currentSimuladoId || simuladoItens.length === 0) return;

    const list = getSavedSimulados();
    const nowIso = new Date().toISOString();

    const record: SavedSimuladoRecord = {
      id: currentSimuladoId,
      titulo: sanitizeSimuladoTitle(currentSimuladoMeta.titulo),
      modo: currentSimuladoMeta.modo,
      ano: currentSimuladoMeta.ano,
      lingua: currentSimuladoMeta.lingua,
      createdAt: currentSimuladoMeta.createdAt || nowIso,
      updatedAt: nowIso,
      status,
      timerSeconds,
      currentIndex,
      acertosCount,
      totalQuestions: simuladoItens.length,
      itemsState: simuladoItens.map((item) => ({
        questaoId: item.questao.id,
        letrasOrdemOriginal: item.alternativasShuffled.map((a) => a.letraOriginal),
        respostaEscolhida: item.respostaEscolhida,
        respostaEscolhidaExibida: item.respostaEscolhidaExibida,
      })),
    };

    const existingIdx = list.findIndex((r) => r.id === currentSimuladoId);
    if (existingIdx >= 0) {
      list.splice(existingIdx, 1);
    }
    list.unshift(record);
    saveSimuladosList(list);
  }

  function deleteSavedSimulado(id: string) {
    const list = getSavedSimulados().filter((r) => r.id !== id);
    saveSimuladosList(list);
    renderRecentSimulados();
  }

  function formatDateShort(iso: string): string {
    try {
      const d = new Date(iso);
      return d.toLocaleDateString('pt-BR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch {
      return '';
    }
  }

  function renderRecentSimulados() {
    if (!recentSimuladosSection || !recentSimuladosList) return;
    const saved = getSavedSimulados();

    if (saved.length === 0) {
      recentSimuladosSection.setAttribute('hidden', '');
      recentSimuladosList.innerHTML = '';
      return;
    }

    recentSimuladosSection.removeAttribute('hidden');
    recentSimuladosList.innerHTML = '';

    saved.forEach((rec) => {
      const cleanTitle = sanitizeSimuladoTitle(rec.titulo);
      const answeredCount = rec.itemsState.filter((i) => Boolean(i.respostaEscolhida)).length;
      const isDone = rec.status === 'concluido';
      const percent = isDone && rec.totalQuestions > 0
        ? Math.round(((rec.acertosCount || 0) / rec.totalQuestions) * 100)
        : Math.round((answeredCount / (rec.totalQuestions || 45)) * 100);

      const card = document.createElement('div');
      card.className = `recent-simulado-item ${isDone ? 'is-completed' : 'is-in-progress'}`;

      const statusBadge = isDone
        ? `<span class="badge badge-sage">Concluído: ${rec.acertosCount ?? 0}/${rec.totalQuestions} (${percent}%)</span>`
        : `<span class="badge badge-gold">Em andamento: ${answeredCount}/${rec.totalQuestions} respondidas</span>`;

      card.innerHTML = `
        <div class="recent-item-info">
          <div class="recent-item-top">
            <strong class="recent-item-title">${escapeHtml(cleanTitle)}</strong>
            ${statusBadge}
          </div>
          <div class="recent-item-meta">
            <span>Tempo: <strong>${formatTime(rec.timerSeconds)}</strong></span>
            <span>•</span>
            <span>Salvo em ${formatDateShort(rec.updatedAt)}</span>
          </div>
        </div>
        <div class="recent-item-actions">
          <button type="button" class="btn ${isDone ? 'btn-secondary' : 'btn-primary'} btn-sm btn-action-resume">
            ${isDone ? 'Ver Resultado' : 'Retomar Simulado'}
          </button>
          <button type="button" class="btn-delete-recent" aria-label="Excluir simulado salvo" title="Excluir do histórico">
            <span class="btn-delete-icon" aria-hidden="true">${trashIconHtml}</span>
            <span class="btn-delete-text">Excluir</span>
          </button>
        </div>
      `;

      const actionBtn = card.querySelector('.btn-action-resume') as HTMLButtonElement;
      const deleteBtn = card.querySelector('.btn-delete-recent') as HTMLButtonElement;

      actionBtn?.addEventListener('click', () => {
        restoreSimuladoFromRecord(rec);
      });

      deleteBtn?.addEventListener('click', () => {
        deleteSavedSimulado(rec.id);
      });

      recentSimuladosList.appendChild(card);
    });
  }

  function restoreSimuladoFromRecord(rec: SavedSimuladoRecord) {
    const letters = ['A', 'B', 'C', 'D', 'E'];
    const reconstructed: SimuladoItem[] = [];

    rec.itemsState.forEach((st) => {
      const q = questoesMap.get(st.questaoId);
      if (!q) return;

      const altMap = new Map(q.alternativas.map((a) => [a.letra, a.texto]));
      const shuffled = st.letrasOrdemOriginal.map((letraOrig, idx) => ({
        letraExibida: letters[idx] || 'A',
        letraOriginal: letraOrig,
        texto: altMap.get(letraOrig) || '',
      }));

      reconstructed.push({
        questao: q,
        alternativasShuffled: shuffled,
        respostaEscolhida: st.respostaEscolhida,
        respostaEscolhidaExibida: st.respostaEscolhidaExibida,
      });
    });

    if (reconstructed.length === 0) {
      deleteSavedSimulado(rec.id);
      return;
    }

    const cleanTitle = sanitizeSimuladoTitle(rec.titulo);
    currentSimuladoId = rec.id;
    currentSimuladoMeta = {
      titulo: cleanTitle,
      modo: rec.modo,
      ano: rec.ano,
      lingua: rec.lingua,
      createdAt: rec.createdAt,
    };
    simuladoItens = reconstructed;
    timerSeconds = rec.timerSeconds || 0;
    currentIndex = Math.min(rec.currentIndex || 0, simuladoItens.length - 1);

    if (examProvaTitle) examProvaTitle.textContent = cleanTitle;
    if (examTimerDisplay) examTimerDisplay.textContent = formatTime(timerSeconds);
    if (examTimerDisplayDesktop) examTimerDisplayDesktop.textContent = formatTime(timerSeconds);

    // Sincroniza a picklist visual de ano caso tenha ano salvo
    if (rec.ano) {
      selectAnoItem(String(rec.ano));
    }

    if (rec.status === 'concluido') {
      showResultScreen(false);
    } else {
      setActiveScreen('exam');
      isTimerPaused = false;
      updatePauseButtonState(false);
      startTimer();
      renderQuestionsGrid();
      renderCurrentQuestion();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  btnClearHistory?.addEventListener('click', () => {
    if (window.confirm('Deseja realmente limpar todo o histórico de simulados salvos neste navegador?')) {
      window.localStorage.removeItem(STORAGE_KEY);
      renderRecentSimulados();
    }
  });

  // ============================================================================
  // INTERAÇÃO NA CONFIGURAÇÃO DO SIMULADO
  // ============================================================================
  // ============================================================================
  // CUSTOM PICKLIST: SELEÇÃO DO ANO DO ENEM (100% IDENTIDADE VISUAL EDITORIAL)
  // ============================================================================
  function closePicklistAno() {
    if (!picklistAnoOptions || !picklistAnoTrigger) return;
    picklistAnoOptions.setAttribute('hidden', '');
    picklistAnoTrigger.setAttribute('aria-expanded', 'false');
    picklistAno?.classList.remove('is-open');
  }

  function openPicklistAno() {
    if (!picklistAnoOptions || !picklistAnoTrigger) return;
    picklistAnoOptions.removeAttribute('hidden');
    picklistAnoTrigger.setAttribute('aria-expanded', 'true');
    picklistAno?.classList.add('is-open');

    // Foco no item atualmente selecionado
    const selectedItem = picklistAnoOptions.querySelector<HTMLElement>('.custom-picklist-item.selected');
    if (selectedItem) {
      selectedItem.focus();
    }
  }

  function togglePicklistAno() {
    if (!picklistAnoOptions) return;
    const isHidden = picklistAnoOptions.hasAttribute('hidden');
    if (isHidden) {
      openPicklistAno();
    } else {
      closePicklistAno();
    }
  }

  function selectAnoItem(anoValue: string) {
    if (!selectAno || !picklistAnoLabel || !picklistAnoOptions) return;
    selectAno.value = anoValue;
    picklistAnoLabel.textContent = `ENEM ${anoValue}`;

    picklistAnoOptions.querySelectorAll('.custom-picklist-item').forEach((item) => {
      const isCurrent = item.getAttribute('data-value') === anoValue;
      item.classList.toggle('selected', isCurrent);
      item.setAttribute('aria-selected', String(isCurrent));
    });

    closePicklistAno();
    picklistAnoTrigger?.focus();
  }

  picklistAnoTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    togglePicklistAno();
  });

  picklistAnoOptions?.querySelectorAll<HTMLElement>('.custom-picklist-item').forEach((item) => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      const val = item.getAttribute('data-value');
      if (val) selectAnoItem(val);
    });

    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const val = item.getAttribute('data-value');
        if (val) selectAnoItem(val);
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = item.nextElementSibling as HTMLElement | null;
        if (next) next.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = item.previousElementSibling as HTMLElement | null;
        if (prev) prev.focus();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closePicklistAno();
        picklistAnoTrigger?.focus();
      }
    });
  });

  picklistAnoTrigger?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openPicklistAno();
    }
  });

  // Fechar picklist ao clicar fora
  document.addEventListener('click', (e) => {
    if (picklistAno && !picklistAno.contains(e.target as Node)) {
      closePicklistAno();
    }
  });

  // Sincronizar classe .selected nos cards de modo e língua
  function setupRadioCardsSync(name: string, selector: string) {
    const inputs = document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
    inputs.forEach((input) => {
      input.addEventListener('change', () => {
        document.querySelectorAll<HTMLElement>(selector).forEach((card) => {
          const cardInput = card.querySelector<HTMLInputElement>('input');
          card.classList.toggle('selected', Boolean(cardInput?.checked));
        });
      });
    });
  }

  setupRadioCardsSync('simulado-modo', '.mode-option-card');
  setupRadioCardsSync('simulado-lingua', '.lang-option-card');

  // Alternar visibilidade das opções de prova oficial
  document.querySelectorAll<HTMLInputElement>('input[name="simulado-modo"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (configOficialGroup) {
        configOficialGroup.style.display = target.value === 'oficial' ? 'block' : 'none';
      }
    });
  });

  // Fisher-Yates Shuffle para embaralhar alternativas
  function shuffleArray<T>(array: T[]): T[] {
    const copy = [...array];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  // Formatar segundos em HH:MM:SS
  function formatTime(totalSeconds: number): string {
    const hrs = Math.floor(totalSeconds / 3600);
    const mins = Math.floor((totalSeconds % 3600) / 60);
    const secs = totalSeconds % 60;
    return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  // Atualiza botões de pausa (mobile e desktop)
  function updatePauseButtonState(paused: boolean) {
    [btnPauseTimer, btnPauseTimerDesktop].forEach((btn) => {
      if (!btn) return;
      const textSpan = btn.querySelector('.timer-pause-text');
      if (textSpan) {
        textSpan.textContent = paused ? 'Retomar' : 'Pausar';
      } else {
        btn.textContent = paused ? 'Retomar' : 'Pausar';
      }
      btn.classList.toggle('btn-primary', paused);
      btn.classList.toggle('btn-secondary', !paused);
    });
  }

  // Cronômetro com salvamento periódico
  function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = window.setInterval(() => {
      if (!isTimerPaused) {
        timerSeconds++;
        const timeFormatted = formatTime(timerSeconds);
        if (examTimerDisplay) examTimerDisplay.textContent = timeFormatted;
        if (examTimerDisplayDesktop) examTimerDisplayDesktop.textContent = timeFormatted;

        if (timerSeconds % 5 === 0) {
          persistCurrentSimulado('em_andamento');
        }
      }
    }, 1000);
  }

  function handleTogglePause() {
    isTimerPaused = !isTimerPaused;
    updatePauseButtonState(isTimerPaused);
    persistCurrentSimulado('em_andamento');
  }

  btnPauseTimer?.addEventListener('click', handleTogglePause);
  btnPauseTimerDesktop?.addEventListener('click', handleTogglePause);

  function handleSaveAndExit() {
    persistCurrentSimulado('em_andamento');
    if (timerInterval) clearInterval(timerInterval);
    setActiveScreen('setup');
    renderRecentSimulados();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  btnSaveExitExam?.addEventListener('click', handleSaveAndExit);
  btnSaveExitExamDesktop?.addEventListener('click', handleSaveAndExit);

  // Iniciar Novo Simulado
  setupForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const formData = new FormData(setupForm);
    const modo = (formData.get('simulado-modo') as 'oficial' | 'aleatorio') || 'oficial';
    const lingua = (formData.get('simulado-lingua') as string) || 'ingles';

    let rawSelecionadas: Questao[] = [];
    let tituloProva = '';
    let anoSelecionado: number | undefined;

    if (modo === 'oficial') {
      anoSelecionado = Number(selectAno.value);
      const targetLang = lingua === 'ingles' ? 'Inglês' : 'Espanhol';
      tituloProva = `ENEM ${anoSelecionado} (${targetLang})`;

      const doAno = questoesRaw.filter((q) => q.ano === anoSelecionado);

      const qLE = doAno
        .filter((q) => q.idioma === targetLang)
        .sort((a, b) => (a.numeroQuestao || 0) - (b.numeroQuestao || 0));

      const qGerais = doAno
        .filter((q) => q.idioma === 'Português')
        .sort((a, b) => (a.numeroQuestao || 0) - (b.numeroQuestao || 0));

      rawSelecionadas = [...qLE.slice(0, 5), ...qGerais.slice(0, 40)];

      if (rawSelecionadas.length < 45) {
        const ids = new Set(rawSelecionadas.map((q) => q.id));
        const extras = doAno.filter((q) => !ids.has(q.id));
        rawSelecionadas.push(...extras.slice(0, 45 - rawSelecionadas.length));
      }
    } else {
      const targetLang = lingua === 'ingles' ? 'Inglês' : 'Espanhol';
      tituloProva = `Simulado ENEM Aleatório (45 Questões — ${targetLang})`;

      const lePool = questoesRaw.filter((q) => q.idioma === targetLang);
      const leSelected = shuffleArray(lePool).slice(0, 5);

      const geraisPool = questoesRaw.filter((q) => q.idioma === 'Português');
      const geraisSelected = shuffleArray(geraisPool).slice(0, 40);

      rawSelecionadas = [...leSelected, ...geraisSelected];
    }

    const questoesFinais = rawSelecionadas.slice(0, 45);

    simuladoItens = questoesFinais.map((q) => {
      const shuffled = shuffleArray(q.alternativas);
      const letters = ['A', 'B', 'C', 'D', 'E'];
      const mapped = shuffled.map((alt, idx) => ({
        letraExibida: letters[idx],
        letraOriginal: alt.letra,
        texto: alt.texto,
      }));

      return {
        questao: q,
        alternativasShuffled: mapped,
      };
    });

    currentSimuladoId = `sim_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
    currentSimuladoMeta = {
      titulo: tituloProva,
      modo,
      ano: anoSelecionado,
      lingua,
      createdAt: new Date().toISOString(),
    };

    setActiveScreen('exam');

    if (examProvaTitle) examProvaTitle.textContent = tituloProva;
    if (examTimerDisplay) examTimerDisplay.textContent = '00:00:00';
    if (examTimerDisplayDesktop) examTimerDisplayDesktop.textContent = '00:00:00';

    currentIndex = 0;
    timerSeconds = 0;
    isTimerPaused = false;
    updatePauseButtonState(false);
    startTimer();
    renderQuestionsGrid();
    renderCurrentQuestion();
    persistCurrentSimulado('em_andamento');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Renderizar o mapa de navegação lateral (1 a 45)
  function renderQuestionsGrid() {
    if (!examQuestionsGrid) return;
    examQuestionsGrid.innerHTML = '';

    simuladoItens.forEach((item, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'grid-q-btn';
      btn.setAttribute('aria-label', `Ir para questão ${idx + 1}`);

      updateSingleGridButtonContent(btn, idx, item);

      btn.addEventListener('click', () => {
        currentIndex = idx;
        closeMobileMapDrawer();
        renderCurrentQuestion();
        updateGridActiveState();
        persistCurrentSimulado('em_andamento');
      });

      examQuestionsGrid.appendChild(btn);
    });

    updateCounters();
  }

  function updateSingleGridButtonContent(btn: HTMLButtonElement, idx: number, item: SimuladoItem) {
    const numStr = String(idx + 1).padStart(2, '0');
    const isAnswered = Boolean(item.respostaEscolhida);
    const chosenLetter = item.respostaEscolhidaExibida || '';

    btn.classList.toggle('current', idx === currentIndex);
    btn.classList.toggle('answered', isAnswered);

    if (isAnswered && chosenLetter) {
      btn.innerHTML = `<span class="grid-q-num">${numStr}</span><span class="grid-q-letter">${chosenLetter}</span>`;
    } else {
      btn.innerHTML = `<span class="grid-q-num">${numStr}</span>`;
    }
  }

  function updateGridActiveState() {
    const btns = examQuestionsGrid?.querySelectorAll<HTMLButtonElement>('.grid-q-btn');
    btns?.forEach((btn, idx) => {
      updateSingleGridButtonContent(btn, idx, simuladoItens[idx]);
    });
    updateCounters();
  }

  function updateCounters() {
    const total = simuladoItens.length || 45;
    const answeredCount = simuladoItens.filter((i) => Boolean(i.respostaEscolhida)).length;
    const pct = Math.round((answeredCount / total) * 100);

    if (examProgressBarFill) {
      examProgressBarFill.style.width = `${pct}%`;
    }
    if (mobileMapBtnText) {
      mobileMapBtnText.textContent = `Questões (${answeredCount}/${total})`;
    }
    if (sidebarLegendInfo) {
      sidebarLegendInfo.textContent = `Clique para saltar (${answeredCount}/${total})`;
    }
  }

  function updateQuestionStatusPill(item: SimuladoItem) {
    if (!qViewStatusPill) return;
    if (item.respostaEscolhida && item.respostaEscolhidaExibida) {
      qViewStatusPill.textContent = `Respondida (Alternativa ${item.respostaEscolhidaExibida})`;
      qViewStatusPill.classList.add('answered');
      qViewStatusPill.classList.remove('unanswered');
      btnClearAnswer?.removeAttribute('hidden');
    } else {
      qViewStatusPill.textContent = 'Pendente';
      qViewStatusPill.classList.add('unanswered');
      qViewStatusPill.classList.remove('answered');
      btnClearAnswer?.setAttribute('hidden', '');
    }
  }

  function renderThumbnailFigureHtml(img: QuestaoImagem): string {
    const src = `/assets/questoes/${escapeHtml(img.arquivo)}`;
    const alt = escapeHtml(img.alt || 'Figura de apoio da questão');
    return `
      <figure class="simulado-figure-thumb">
        <button
          type="button"
          class="simulado-img-thumb-btn"
          data-zoom-src="${src}"
          data-zoom-alt="${alt}"
          aria-label="Ampliar imagem: ${alt}"
        >
          <img src="${src}" alt="${alt}" class="simulado-thumb-img" loading="lazy" />
          <span class="simulado-thumb-hint">🔍 Clique para ampliar</span>
        </button>
        ${img.alt ? `<figcaption class="simulado-thumb-caption">${alt}</figcaption>` : ''}
      </figure>
    `;
  }

  // Renderizar a questão atual no viewport
  function renderCurrentQuestion() {
    const item = simuladoItens[currentIndex];
    if (!item) return;

    const q = item.questao;

    if (qViewNum) qViewNum.textContent = `Questão ${String(currentIndex + 1).padStart(2, '0')} de ${simuladoItens.length}`;
    if (qViewCat) qViewCat.textContent = q.categoria;
    if (qViewHabilidade) qViewHabilidade.textContent = q.habilidade || 'Competência do ENEM';
    if (qViewTitle) qViewTitle.textContent = q.titulo;

    // Imagens de apoio em miniatura clicável para abrir o modal de zoom
    const qViewImages = document.getElementById('q-view-images');
    if (qViewImages) {
      if (q.imagens && q.imagens.length > 0) {
        qViewImages.innerHTML = q.imagens.map((img) => renderThumbnailFigureHtml(img)).join('');
        qViewImages.style.display = 'flex';
      } else {
        qViewImages.innerHTML = '';
        qViewImages.style.display = 'none';
      }
    }

    if (qViewTextBase) qViewTextBase.textContent = q.textoBase;
    if (qViewRef) qViewRef.textContent = q.referenciaTexto;
    if (qViewEnunciado) qViewEnunciado.textContent = q.enunciado;

    updateQuestionStatusPill(item);

    // Renderizar alternativas embaralhadas com caixa de seleção moderna e letra separada
    if (qOptionsForm) {
      qOptionsForm.innerHTML = '';
      item.alternativasShuffled.forEach((alt) => {
        const isSelected = item.respostaEscolhida === alt.letraOriginal;

        const label = document.createElement('label');
        label.className = `exam-option-card${isSelected ? ' selected' : ''}`;

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'exam-q-alt';
        input.className = 'sr-only-input';
        input.value = alt.letraOriginal;
        input.checked = isSelected;

        input.addEventListener('change', () => {
          item.respostaEscolhida = alt.letraOriginal;
          item.respostaEscolhidaExibida = alt.letraExibida;

          qOptionsForm.querySelectorAll('.exam-option-card').forEach((c) => c.classList.remove('selected'));
          label.classList.add('selected');

          updateQuestionStatusPill(item);
          updateGridActiveState();
          persistCurrentSimulado('em_andamento');
        });

        const checkIndicator = document.createElement('span');
        checkIndicator.className = 'exam-opt-check';
        checkIndicator.setAttribute('aria-hidden', 'true');

        const letterBadge = document.createElement('span');
        letterBadge.className = 'exam-opt-letter';
        letterBadge.textContent = alt.letraExibida;

        const textSpan = document.createElement('span');
        textSpan.className = 'exam-opt-text';
        textSpan.textContent = alt.texto;

        label.appendChild(input);
        label.appendChild(checkIndicator);
        label.appendChild(letterBadge);
        label.appendChild(textSpan);

        qOptionsForm.appendChild(label);
      });
    }

    // Botões anterior/próxima
    if (btnPrev) btnPrev.disabled = currentIndex === 0;
    if (btnNext) {
      if (currentIndex === simuladoItens.length - 1) {
        btnNext.textContent = 'Finalizar Simulado 🏁';
      } else {
        btnNext.textContent = 'Próxima Questão →';
      }
    }

    updateGridActiveState();

    // Rolar apenas o container da questão para o topo
    if (examQuestionViewport) {
      examQuestionViewport.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // Limpar resposta da questão atual
  btnClearAnswer?.addEventListener('click', () => {
    const item = simuladoItens[currentIndex];
    if (!item) return;
    item.respostaEscolhida = undefined;
    item.respostaEscolhidaExibida = undefined;
    renderCurrentQuestion();
    persistCurrentSimulado('em_andamento');
  });

  btnPrev?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      renderCurrentQuestion();
      persistCurrentSimulado('em_andamento');
    }
  });

  btnNext?.addEventListener('click', () => {
    if (currentIndex < simuladoItens.length - 1) {
      currentIndex++;
      renderCurrentQuestion();
      persistCurrentSimulado('em_andamento');
    } else {
      btnFinishExam?.click();
    }
  });

  function showResultScreen(shouldPersist: boolean) {
    if (timerInterval) clearInterval(timerInterval);

    let acertos = 0;
    simuladoItens.forEach((item) => {
      if (
        item.respostaEscolhida &&
        item.respostaEscolhida.trim().toUpperCase() === item.questao.gabarito.trim().toUpperCase()
      ) {
        acertos++;
      }
    });

    if (shouldPersist) {
      persistCurrentSimulado('concluido', acertos);
    }

    const total = simuladoItens.length;
    const percent = Math.round((acertos / (total || 1)) * 100);
    const avgSecondsPerQ = Math.round(timerSeconds / (total || 1));
    const avgMins = Math.floor(avgSecondsPerQ / 60);
    const avgSecs = avgSecondsPerQ % 60;

    if (resultSimuladoSubtitle) resultSimuladoSubtitle.textContent = sanitizeSimuladoTitle(currentSimuladoMeta.titulo);
    if (resultScoreAcertos) resultScoreAcertos.textContent = `${acertos} / ${total}`;
    if (resultScorePercent) resultScorePercent.textContent = `${percent}%`;
    if (resultStatTempoTotal) resultStatTempoTotal.textContent = formatTime(timerSeconds);
    if (resultStatTempoMedio) resultStatTempoMedio.textContent = `${avgMins}min ${String(avgSecs).padStart(2, '0')}s`;

    if (resultHeadline) {
      if (percent >= 80) resultHeadline.textContent = 'Excelente Desempenho!';
      else if (percent >= 60) resultHeadline.textContent = 'Bom Resultado — Foco na Constância!';
      else resultHeadline.textContent = 'Treino Concluído — Hora da Revisão Crítica!';
    }

    if (resultFeedbackMsg) {
      let msg = '';
      if (percent >= 80) {
        msg = `Parabéns! Você alcançou um nível altamente competitivo para o ENEM em Linguagens (${percent}% de acerto). O tempo médio de ${avgMins}min ${avgSecs}s por questão mostra boa segurança na leitura e eliminação de distratores.`;
      } else if (percent >= 60) {
        msg = `Você obteve ${percent}% de acerto (${acertos} de ${total}). É uma base sólida, mas vale aprofundar nos tópicos onde você errou (veja a resolução comentada questão a questão abaixo) para transformar esses pontos em acertos na prova oficial.`;
      } else {
        msg = `Você completou o simulado com ${percent}% de acerto. No ENEM, a prova de Linguagens exige fôlego de leitura e atenção redobrada aos comandos. Revise com calma as justificativas pedagógicas abaixo para identificar os padrões dos distratores do INEP.`;
      }
      resultFeedbackMsg.innerHTML = `<p>${msg}</p>`;
    }

    if (resultReviewList) {
      resultReviewList.innerHTML = '';

      simuladoItens.forEach((item, idx) => {
        const q = item.questao;
        const acertou = item.respostaEscolhida?.toUpperCase() === q.gabarito.toUpperCase();

        const card = document.createElement('article');
        card.className = `card review-question-card ${acertou ? 'review-correct' : 'review-wrong'}`;

        const statusBadge = acertou
          ? '<span class="badge badge-sage">Você Acertou</span>'
          : '<span class="badge badge-rose">Você Errou</span>';

        const escolhaTxt = item.respostaEscolhida
          ? `Sua resposta: <strong>Alternativa ${item.respostaEscolhidaExibida || item.respostaEscolhida}</strong> (original ${item.respostaEscolhida})`
          : '<strong style="color: var(--color-wine-800);">Não respondida</strong>';

        const reviewImagesHtml =
          q.imagens && q.imagens.length > 0
            ? `<div class="q-images-container">
                ${q.imagens.map((img) => renderThumbnailFigureHtml(img)).join('')}
              </div>`
            : '';

        card.innerHTML = `
          <div class="review-header-row">
            <div class="review-badges">
              <span class="badge badge-slate">Questão ${String(idx + 1).padStart(2, '0')}</span>
              <span class="badge badge-gold">ENEM ${q.ano || 2025}</span>
              <span class="badge badge-wine">${escapeHtml(q.categoria)}</span>
              ${statusBadge}
            </div>
          </div>

          <h4 class="review-title">${escapeHtml(q.titulo)}</h4>

          <div class="q-support-text">
            ${reviewImagesHtml}
            <p>${escapeHtml(q.textoBase)}</p>
            <cite>${escapeHtml(q.referenciaTexto)}</cite>
          </div>

          <p class="q-statement">${escapeHtml(q.enunciado)}</p>

          <div class="review-answers-box">
            <p class="review-user-choice">${escolhaTxt}</p>
            <p class="review-official-choice">Gabarito Oficial: <strong>Alternativa ${escapeHtml(q.gabarito)}</strong></p>
          </div>

          <details class="q-resolution" open>
            <summary>Comentário Pedagógico Fundamentado</summary>
            <div class="q-resolution-body">
              <p class="q-commentary">${escapeHtml(q.comentarioPedagogico)}</p>
            </div>
          </details>
        `;

        resultReviewList.appendChild(card);
      });
    }

    setActiveScreen('result');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Finalizar Simulado (mobile e desktop)
  function handleFinishExam() {
    const unanswered = simuladoItens.filter((i) => !i.respostaEscolhida).length;
    if (unanswered > 0) {
      const confirmFinish = window.confirm(
        `Você ainda possui ${unanswered} questão(ões) sem resposta. Deseja realmente finalizar o simulado agora e gerar o relatório?`
      );
      if (!confirmFinish) return;
    }

    showResultScreen(true);
  }

  btnFinishExam?.addEventListener('click', handleFinishExam);
  btnFinishExamDesktop?.addEventListener('click', handleFinishExam);

  // Voltar ao início / realizar novo simulado
  btnRestartSimulado?.addEventListener('click', () => {
    setActiveScreen('setup');
    renderRecentSimulados();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Inicializar lista de simulados recentes ao carregar a página
  renderRecentSimulados();
</script>

