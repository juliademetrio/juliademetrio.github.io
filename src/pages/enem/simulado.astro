    box-shadow: 0 0 0 3px rgba(104, 45, 52, 0.14);
  }

  .picklist-arrow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-wine-800);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .custom-picklist.is-open .picklist-arrow-icon {
    transform: rotate(180deg);
  }

  .custom-picklist-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 60;
    list-style: none;
    padding: 0.4rem;
    margin: 0;
    max-height: 250px;
    overflow-y: auto;
    background-color: #ffffff;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-rose-200);
    box-shadow: 0 12px 32px rgba(70, 27, 32, 0.14);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .custom-picklist-menu[hidden] {
    display: none !important;
  }

  .custom-picklist-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-800, #2c2527);
    cursor: pointer;
    transition: all 0.12s ease;
    user-select: none;
    outline: none;
  }

  .custom-picklist-item:hover,
  .custom-picklist-item:focus {
    background-color: var(--color-rose-100);
    color: var(--color-wine-900);
  }

  .custom-picklist-item.selected {
    background-color: var(--color-wine-800);
    color: #ffffff;
    font-weight: 700;
  }

  .custom-picklist-item.selected:hover,
  .custom-picklist-item.selected:focus {
    background-color: var(--color-wine-900);
    color: #ffffff;
  }

  .picklist-item-check {
    display: none;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .custom-picklist-item.selected .picklist-item-check {
    display: inline-flex;
  }

  .setup-cta-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .setup-tips {
    background-color: var(--color-rose-50);
    border-left: 3px solid var(--color-wine-800);
    padding: 0.85rem 1rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--text-xs);
    color: var(--color-wine-900);
    line-height: 1.5;
  }

  .btn-start-simulado {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  /* ============================================================================
     EXAM SCREEN — CONTAINER TRAVADO + ROLAGEM EXCLUSIVA DA QUESTÃO
     ============================================================================ */
  .simulado-page-container [hidden] {
    display: none !important;
  }

  .exam-section:not([hidden]) {
    height: calc(100dvh - 68px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.4rem 0;
  }

  @media (min-width: 1024px) {
    .exam-section:not([hidden]) {
      height: calc(100vh - 76px);
      padding: 0.85rem 0;
    }
  }

  .exam-section > .container {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* BARRA FIXA SUPERIOR NO MOBILE (< 1024px) — APENAS 2 LINHAS ULTRACOMPACTAS */
  .exam-mobile-top-bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    margin-bottom: 0.4rem;
    border: 1px solid var(--color-cream-300);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    background-color: #fff;
  }

  @media (min-width: 1024px) {
    .exam-mobile-top-bar {
      display: none !important;
    }
  }

  .exam-mobile-row-primary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .exam-mobile-row-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-cream-200);
  }

  .btn-compact-action {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .btn-finish-action {
    background-color: var(--color-wine-800);
    color: #fff;
    font-weight: 700;
  }

  .btn-finish-action:hover {
    background-color: var(--color-wine-900);
  }

  .btn-mobile-map-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--color-wine-900);
    border-color: var(--color-rose-300);
    background-color: var(--color-rose-50);
  }

  .btn-timer-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.45rem;
    font-size: 0.68rem;
  }

  /* Cronômetro Moderno com Foco e SVG */
  .timer-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-cream-100);
    border: 1px solid var(--color-cream-300);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  .timer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-wine-800);
  }

  .timer-digits {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--color-wine-900);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Layout Geral da Prova */
  .exam-body-layout {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .exam-body-layout {
      display: grid;
      grid-template-columns: 310px 1fr;
      gap: 1.25rem;
      align-items: stretch;
    }
  }

  /* SIDEBAR EM DESKTOP E DRAWER EM MOBILE */
  .exam-sidebar {
    display: none;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
    background-color: #fff;
    overflow-y: auto;
  }

  /* Drawer sobreposto no mobile quando acionado */
  .exam-sidebar.mobile-open {
    display: flex;
    position: absolute;
    inset: 0;
    z-index: 30;
    height: 100%;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.16);
  }

  @media (min-width: 1024px) {
    .exam-sidebar {
      display: flex;
      position: static;
      height: 100%;
      overflow-y: auto;
      box-shadow: none;
      padding: 1rem 1.15rem;
    }
  }

  /* Bloco de Controle do Simulado Integrado no Painel Lateral (Desktop) */
  .sidebar-control-card {
    display: none;
    flex-direction: column;
    gap: 0.65rem;
    padding-bottom: 0.85rem;
    border-bottom: 1.5px solid var(--color-cream-200);
  }

  @media (min-width: 1024px) {
    .sidebar-control-card {
      display: flex;
    }
  }

  .sidebar-exam-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .exam-title-badge {
    font-weight: 700;
    font-size: var(--text-xs);
    color: var(--color-wine-900);
    line-height: 1.25;
  }

  .exam-progress-track {
    width: 100%;
    height: 5px;
    background-color: var(--color-cream-200);
    border-radius: 999px;
    overflow: hidden;
  }

  .exam-progress-fill {
    height: 100%;
    background-color: var(--color-wine-800);
    border-radius: 999px;
    transition: width 0.25s ease;
  }

  .desktop-timer-container {
    display: flex;
    justify-content: center;
  }

  .desktop-timer-box {
    width: 100%;
    justify-content: space-between;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-cream-50);
  }

  .desktop-timer-box .timer-digits {
    font-size: 1.15rem;
  }

  .desktop-actions-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
  }

  .desktop-actions-row .btn-compact-action {
    justify-content: center;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .sidebar-header h3 {
    font-size: 0.95rem;
    color: var(--color-wine-900);
    margin: 0;
  }

  .sidebar-legend-info {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  .btn-close-mobile-map {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  @media (min-width: 1024px) {
    .btn-close-mobile-map {
      display: none !important;
    }
  }

  .questions-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
  }

  /* Botões de questão no mapa lateral — :global pois são criados via JS */
  .simulado-page-container :global(.grid-q-btn) {
    min-height: 40px;
    padding: 0.2rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-cream-300);
    background-color: var(--color-cream-50);
    color: var(--color-ink-700);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
    gap: 0.1rem;
  }

  .simulado-page-container :global(.grid-q-btn:hover) {
    border-color: var(--color-rose-500);
    background-color: var(--color-rose-50);
  }

  .simulado-page-container :global(.grid-q-btn.current) {
    outline: 2.5px solid var(--color-wine-800);
    outline-offset: 1px;
    font-weight: 800;
  }

  .simulado-page-container :global(.grid-q-btn.answered) {
    background-color: var(--color-wine-800);
    border-color: var(--color-wine-800);
    color: #fff;
  }

  .simulado-page-container :global(.grid-q-letter) {
    font-size: 0.65rem;
    font-weight: 800;
    background-color: rgba(255, 255, 255, 0.22);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    color: #fff;
  }

  .sidebar-legend {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid var(--color-cream-200);
    padding-top: 0.75rem;
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
  }

  .dot-answered {
    background-color: var(--color-wine-800);
  }

  .dot-current {
    background-color: var(--color-cream-50);
    border: 2px solid var(--color-wine-800);
  }

  .dot-unanswered {
    background-color: var(--color-cream-200);
  }

  /* ÁREA ROLÁVEL EXCLUSIVA DA QUESTÃO */
  .exam-question-area {
    flex: 1;
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  @media (min-width: 768px) {
    .exam-question-area {
      padding: 1.85rem 2rem;
      gap: 1.25rem;
    }
  }

  /* MINIATURAS DE IMAGEM COMPACTAS E CLICÁVEIS + MODAL DE ZOOM */
  .simulado-page-container :global(.q-images-container) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
    align-items: flex-start;
    justify-content: center;
  }

  .simulado-page-container :global(.simulado-figure-thumb) {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 280px;
  }

  .simulado-page-container :global(.simulado-img-thumb-btn) {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 0.45rem;
    background-color: #fff;
    border: 1.5px solid var(--color-cream-300);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    cursor: zoom-in;
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }

  .simulado-page-container :global(.simulado-img-thumb-btn:hover) {
    border-color: var(--color-wine-800);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(96, 26, 36, 0.14);
  }

  .simulado-page-container :global(.simulado-thumb-img) {
    max-width: 240px;
    max-height: 165px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    display: block;
  }

  .simulado-page-container :global(.simulado-thumb-hint) {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-wine-900);
    background-color: var(--color-rose-50);
    border: 1px solid var(--color-rose-200);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .simulado-page-container :global(.simulado-thumb-caption) {
    font-size: 0.75rem;
    color: var(--color-ink-500);
    margin-top: 0.3rem;
    font-style: italic;
    text-align: center;
    line-height: 1.35;
  }

  .image-zoom-modal:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .zoom-modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(20, 14, 16, 0.82);
    backdrop-filter: blur(3px);
  }

  .zoom-modal-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    max-height: 90dvh;
    background-color: #fff;
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--color-cream-300);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .zoom-modal-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1.15rem;
    background-color: var(--color-cream-100);
    border-bottom: 1px solid var(--color-cream-300);
    flex-shrink: 0;
  }

  .zoom-controls-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .zoom-level-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    min-width: 52px;
    text-align: center;
    color: var(--color-wine-900);
    background-color: #fff;
    border: 1px solid var(--color-cream-300);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-xs);
  }

  .zoom-modal-stage {
    flex: 1;
    min-height: 260px;
    max-height: calc(90dvh - 110px);
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background-color: var(--color-cream-50);
  }

  .zoom-modal-img {
    max-width: 100%;
    max-height: 72dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    transform-origin: center center;
    transition: transform 0.15s ease;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .zoom-modal-caption {
    margin: 0;
    padding: 0.6rem 1.15rem;
    font-size: var(--text-xs);
    color: var(--color-ink-600);
    background-color: #fff;
    border-top: 1px solid var(--color-cream-200);
    text-align: center;
    font-style: italic;
    flex-shrink: 0;
  }

  .question-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .question-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .q-current-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-wine-800);
  }

  .q-skill-label {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  .q-status-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  .q-status-pill.unanswered {
    background-color: var(--color-cream-200);
    color: var(--color-ink-600);
  }

  .q-status-pill.answered {
    background-color: var(--color-sage-100);
    color: var(--color-sage-800);
    border: 1px solid var(--color-sage-600);
  }

  .q-active-title {
    font-size: 1.25rem;
    color: var(--color-ink-900);
    line-height: 1.35;
  }

  .q-support-text {
    background-color: var(--color-cream-100);
    border-left: 3px solid var(--color-gold-500);
    padding: 1.15rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .q-support-text p {
    font-size: var(--text-sm);
    line-height: 1.65;
    margin-bottom: 0.5rem;
    white-space: pre-line;
  }

  .q-support-text cite {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    font-style: normal;
    text-align: right;
  }

  .q-statement {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink-900);
    line-height: 1.5;
  }

  .exam-options-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Cards de alternativa gerados via JS — uso obrigatório de :global */
  .simulado-page-container :global(.exam-option-card) {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1rem 1.2rem;
    border: 2px solid var(--color-cream-300);
    border-radius: var(--radius-md);
    background-color: var(--color-cream-50);
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .simulado-page-container :global(.exam-option-card:hover) {
    border-color: var(--color-rose-500);
    background-color: var(--color-rose-50);
    transform: translateY(-1px);
  }

  .simulado-page-container :global(.exam-option-card.selected) {
    border-color: var(--color-wine-800);
    background-color: var(--color-rose-50);
    box-shadow: 0 3px 12px rgba(96, 26, 36, 0.1);
  }

  /* Caixa de seleção moderna customizada */
  .simulado-page-container :global(.exam-opt-check) {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid var(--color-cream-400, #bfb3a4);
    background-color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.25rem;
    transition: all 0.15s ease;
  }

  .simulado-page-container :global(.exam-option-card:hover .exam-opt-check) {
    border-color: var(--color-wine-800);
  }

  .simulado-page-container :global(.exam-option-card.selected .exam-opt-check) {
    background-color: var(--color-wine-800);
    border-color: var(--color-wine-800);
  }

  .simulado-page-container :global(.exam-option-card.selected .exam-opt-check::after) {
    content: '✓';
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1;
  }

  /* Badge da letra (A, B, C, D, E) claramente separado do texto */
  .simulado-page-container :global(.exam-opt-letter) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 0.45rem;
    border-radius: 999px;
    background-color: var(--color-cream-200);
    border: 1px solid var(--color-cream-300);
    color: var(--color-wine-900);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .simulado-page-container :global(.exam-option-card.selected .exam-opt-letter) {
    background-color: var(--color-wine-800);
    border-color: var(--color-wine-800);
    color: #fff;
  }

  .simulado-page-container :global(.exam-opt-text) {
    flex: 1;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-900);
    padding-top: 0.2rem;
  }

  .simulado-page-container :global(.exam-option-card.selected .exam-opt-text) {
    font-weight: 600;
    color: var(--color-wine-900);
  }

  .q-clear-row {
    display: flex;
    justify-content: flex-end;
    min-height: 1.5rem;
  }

  .btn-clear-choice {
    background: none;
    border: none;
    color: var(--color-ink-500);
    font-size: var(--text-xs);
    font-weight: 600;
