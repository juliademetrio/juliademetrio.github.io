---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getQuestoesComentadas } from '../../utils/content';
import timerIcon from '../../assets/icons/timer.svg?raw';
import gridIcon from '../../assets/icons/grid.svg?raw';
import flagIcon from '../../assets/icons/flag.svg?raw';
import arrowLeftIcon from '../../assets/icons/arrow-left.svg?raw';
import pauseIcon from '../../assets/icons/pause.svg?raw';
import playIcon from '../../assets/icons/play.svg?raw';
import closeIcon from '../../assets/icons/close.svg?raw';
import checkIcon from '../../assets/icons/check.svg?raw';
import trashIcon from '../../assets/icons/trash.svg?raw';
import chevronDownIcon from '../../assets/icons/chevron-down.svg?raw';

const todasQuestoes = getQuestoesComentadas();

// Mapear anos disponíveis em ordem decrescente
const anosDisponiveis = Array.from(
  new Set(todasQuestoes.map((q) => q.ano).filter(Boolean))
).sort((a, b) => (b as number) - (a as number)) as number[];
---

<BaseLayout
  title="Simulado ENEM Online — Linguagens"
  description="Treine com simulados cronometrados de Linguagens, Códigos e suas Tecnologias. Resolva provas oficiais do ENEM (2016 a 2025) ou monte simulados aleatórios com alternativas embaralhadas."
>
  <div class="simulado-page-container">
    <!-- Header da Página -->
    <section id="simulado-header-section" class="section section-editorial simulado-header-section">
      <div class="container">
        <Breadcrumbs
          items={[
            { label: 'Portal ENEM', href: '/' },
            { label: 'Simulado ENEM Online' },
          ]}
        />
        <span class="eyebrow">Treino em Condições Reais de Prova</span>
        <h1>Simulado ENEM Online de Linguagens</h1>
        <p class="lead" style="max-width: 68ch; margin-top: 0.5rem;">
          Pratique a gestão do tempo para o 1º dia do ENEM: resolva uma prova oficial completa (45 questões) ou sorteie 45 questões aleatórias. No simulado, as alternativas são <strong>embaralhadas</strong> para exercitar o raciocínio sem viés de gabarito estático.
        </p>
      </div>
    </section>

    <!-- FASE 1: TELA DE CONFIGURAÇÃO DO SIMULADO + HISTÓRICO LOCAL -->
    <section id="simulado-setup-screen" class="section">
      <div class="container container-sm">
        <!-- Bloco de Simulados Recentes Salvos no LocalStorage -->
        <div id="recent-simulados-section" class="card recent-simulados-card" hidden>
          <div class="recent-header">
            <div>
              <span class="eyebrow eyebrow-wine">Salvos no seu navegador</span>
              <h2>Simulados Recentes</h2>
              <p>Retome um simulado em andamento de onde parou ou consulte o gabarito de provas já finalizadas.</p>
            </div>
            <button type="button" id="btn-clear-history" class="btn btn-secondary btn-xs">
              Limpar histórico
            </button>
          </div>

          <div id="recent-simulados-list" class="recent-simulados-list">
            <!-- Cards de simulados recentes gerados via JS -->
          </div>
        </div>

        <div class="card setup-card">
          <div class="setup-header">
            <h2>Configurar Novo Simulado</h2>
            <p>Selecione o formato da prova antes de iniciar a contagem do cronômetro.</p>
          </div>

          <form id="simulado-setup-form" class="setup-form">
            <!-- Escolha do Modo -->
            <fieldset class="form-fieldset">
              <legend class="form-legend">Tipo de Simulado</legend>
              <div class="mode-options-grid">
                <label class="mode-option-card selected">
                  <input type="radio" name="simulado-modo" value="oficial" class="sr-only-input" checked />
                  <span class="custom-radio-indicator" aria-hidden="true"></span>
                  <div class="mode-content">
                    <span class="mode-title">Prova Oficial do ENEM</span>
                    <span class="mode-desc">Resolva uma edição oficial na ordem das 45 questões de Linguagens (com alternativas embaralhadas).</span>
                  </div>
                </label>

                <label class="mode-option-card">
                  <input type="radio" name="simulado-modo" value="aleatorio" class="sr-only-input" />
                  <span class="custom-radio-indicator" aria-hidden="true"></span>
                  <div class="mode-content">
                    <span class="mode-title">Simulado Aleatório (45 Questões)</span>
                    <span class="mode-desc">Sorteio de 45 questões representativas de todos os tópicos (Literatura, Interpretação, Variação Linguística, Artes, etc.).</span>
                  </div>
                </label>
              </div>
            </fieldset>

            <!-- Configurações de Prova Oficial (Ano) -->
            <div id="config-oficial-group" class="config-subgroup">
              <div class="form-group-row">
                <div class="form-field">
                  <label id="label-ano-enem" class="form-field-label">Ano do ENEM:</label>
                  <div class="custom-picklist" id="picklist-ano">
                    <button
                      type="button"
                      class="custom-picklist-trigger"
                      id="picklist-ano-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-labelledby="label-ano-enem picklist-ano-trigger"
                    >
                      <span class="picklist-trigger-value" id="picklist-ano-label">ENEM {anosDisponiveis[0] || 2025}</span>
                      <span class="picklist-arrow-icon" aria-hidden="true">
                        <Fragment set:html={chevronDownIcon} />
                      </span>
                    </button>

                    <ul
                      class="custom-picklist-menu"
                      id="picklist-ano-options"
                      role="listbox"
                      aria-labelledby="label-ano-enem"
                      tabindex="-1"
                      hidden
                    >
                      {anosDisponiveis.map((ano, idx) => (
                        <li
                          role="option"
                          class:list={['custom-picklist-item', { selected: idx === 0 }]}
                          data-value={ano}
                          aria-selected={idx === 0 ? 'true' : 'false'}
                          tabindex="0"
                        >
                          <span class="picklist-item-label">ENEM {ano}</span>
                          <span class="picklist-item-check" aria-hidden="true">
                            <Fragment set:html={checkIcon} />
                          </span>
                        </li>
                      ))}
                    </ul>

                    <!-- Select original sincronizado para compatibilidade nativa de formulário -->
                    <select id="select-ano" name="select-ano" class="sr-only-input" tabindex="-1">
                      {anosDisponiveis.map((ano) => <option value={ano}>ENEM {ano}</option>)}
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- Escolha da Língua Estrangeira (Inglês ou Espanhol) -->
            <fieldset class="form-fieldset">
              <legend class="form-legend">Opção de Língua Estrangeira (Questões 1 a 5)</legend>
              <div class="lang-options-grid">
                <label class="lang-option-card selected">
                  <input type="radio" name="simulado-lingua" value="ingles" class="sr-only-input" checked />
                  <span class="custom-radio-indicator" aria-hidden="true"></span>
                  <span class="lang-label">Inglês (Questões 01 a 05)</span>
                </label>
                <label class="lang-option-card">
                  <input type="radio" name="simulado-lingua" value="espanhol" class="sr-only-input" />
                  <span class="custom-radio-indicator" aria-hidden="true"></span>
                  <span class="lang-label">Espanhol (Questões 01 a 05)</span>
                </label>
              </div>
            </fieldset>

            <div class="setup-cta-box">
              <div class="setup-tips">
                <div class="setup-tips-icon" aria-hidden="true">
                  <Fragment set:html={timerIcon} />
                </div>
                <span><strong>Dica pedagógica:</strong> O tempo médio recomendado para as 45 questões de Linguagens no ENEM é de <strong>2h30 a 2h45</strong> (cerca de 3min15s a 3min30s por questão). Seu progresso fica salvo automaticamente no navegador.</span>
              </div>
              <button type="submit" class="btn btn-primary btn-lg btn-start-simulado">
                <Fragment set:html={timerIcon} />
                <span>Iniciar Simulado Agora</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- FASE 2: TELA DE PROVA / SIMULADO EM ANDAMENTO -->
    <section id="simulado-exam-screen" class="section exam-section" hidden>
      <div class="container">
        <!-- Barra Fixa Superior Compacta do Exame (Visível apenas em Mobile < 1024px) -->
        <div class="exam-mobile-top-bar card">
          <!-- Linha 1: Botão de Mapa de Questões (com contador) e Cronômetro em Destaque -->
          <div class="exam-mobile-row-primary">
            <button type="button" id="btn-toggle-map-mobile" class="btn btn-secondary btn-xs btn-mobile-map-toggle" aria-expanded="false" aria-controls="exam-sidebar-panel">
              <Fragment set:html={gridIcon} />
              <span id="mobile-map-btn-text">Questões (0/45)</span>
            </button>

            <div class="timer-box" role="timer" aria-live="off">
              <span class="timer-icon" aria-hidden="true">
                <Fragment set:html={timerIcon} />
              </span>
              <span id="exam-timer-display" class="timer-digits">00:00:00</span>
              <button type="button" id="btn-pause-timer" class="btn btn-secondary btn-xs btn-timer-toggle" aria-label="Pausar ou retomar cronômetro">
                <span class="timer-pause-icon"><Fragment set:html={pauseIcon} /></span>
                <span class="timer-pause-text">Pausar</span>
              </button>
            </div>
          </div>

          <!-- Linha 2: Ações compactas (Salvar e Sair / Finalizar Simulado) -->
          <div class="exam-mobile-row-secondary">
            <button type="button" id="btn-save-exit-exam" class="btn btn-secondary btn-xs btn-compact-action" title="Seu progresso já está salvo no navegador">
              <Fragment set:html={arrowLeftIcon} />
              <span>Salvar e Sair</span>
            </button>
            <button type="button" id="btn-finish-exam" class="btn btn-primary btn-xs btn-compact-action btn-finish-action">
              <Fragment set:html={flagIcon} />
              <span>Finalizar</span>
            </button>
          </div>
        </div>

        <div class="exam-body-layout">
          <!-- Grade Lateral Travada de Navegação (1 a 45) + Card de Controle Integrado no Desktop -->
          <aside id="exam-sidebar-panel" class="exam-sidebar card">
            <!-- Bloco de Controle do Simulado no Painel Lateral (Em Desktop no topo da coluna) -->
            <div class="sidebar-control-card">
              <div class="sidebar-exam-info">
                <span id="exam-prova-title" class="exam-title-badge">ENEM 2025 (Inglês)</span>
                <div class="exam-progress-track" aria-hidden="true" title="Progresso">
                  <div id="exam-progress-bar-fill" class="exam-progress-fill" style="width: 0%"></div>
                </div>
              </div>

              <!-- Cronômetro Desktop (Sincronizado via JS ou duplicado no mobile/desktop) -->
              <div class="desktop-timer-container">
                <div class="timer-box desktop-timer-box" role="timer" aria-live="off">
                  <span class="timer-icon" aria-hidden="true">
                    <Fragment set:html={timerIcon} />
                  </span>
                  <span id="exam-timer-display-desktop" class="timer-digits">00:00:00</span>
                  <button type="button" id="btn-pause-timer-desktop" class="btn btn-secondary btn-xs btn-timer-toggle" aria-label="Pausar ou retomar cronômetro">
                    <span class="timer-pause-icon"><Fragment set:html={pauseIcon} /></span>
                    <span class="timer-pause-text">Pausar</span>
                  </button>
                </div>
              </div>

              <div class="desktop-actions-row">
                <button type="button" id="btn-save-exit-exam-desktop" class="btn btn-secondary btn-xs btn-compact-action" title="Seu progresso já está salvo no navegador">
                  <Fragment set:html={arrowLeftIcon} />
                  <span>Salvar e Sair</span>
                </button>
                <button type="button" id="btn-finish-exam-desktop" class="btn btn-primary btn-xs btn-compact-action btn-finish-action">
                  <Fragment set:html={flagIcon} />
                  <span>Finalizar</span>
                </button>
              </div>
            </div>

            <div class="sidebar-header">
              <div>
                <h3>Mapa de Questões</h3>
                <span class="sidebar-legend-info" id="sidebar-legend-info">Clique para saltar (0/45)</span>
              </div>
              <button type="button" id="btn-close-map-mobile" class="btn btn-secondary btn-xs btn-close-mobile-map" aria-label="Fechar mapa de questões">
                <Fragment set:html={closeIcon} />
                <span>Fechar</span>
              </button>
            </div>
            <div class="questions-grid" id="exam-questions-grid" role="navigation" aria-label="Navegação entre questões do simulado">
              <!-- Botões de 1 a 45 gerados via JS -->
            </div>
            <div class="sidebar-legend">
              <div class="legend-item"><span class="dot dot-answered"></span> Respondida</div>
              <div class="legend-item"><span class="dot dot-current"></span> Questão atual</div>
              <div class="legend-item"><span class="dot dot-unanswered"></span> Pendente</div>
            </div>
          </aside>

          <!-- Área Rolável Exclusiva da Questão Atual -->
          <main class="exam-question-area card" id="exam-question-viewport">
            <div class="question-header">
              <div class="question-meta">
                <span id="q-view-num" class="q-current-badge">Questão 01 de 45</span>
                <span id="q-view-cat" class="badge badge-rose">Literatura</span>
                <span id="q-view-habilidade" class="q-skill-label">Competência 5</span>
              </div>
              <span id="q-view-status-pill" class="q-status-pill unanswered">Pendente</span>
            </div>

            <h2 id="q-view-title" class="q-active-title">Título da Questão</h2>

            <div class="q-support-text" id="q-view-text-container">
              <div id="q-view-images" class="q-images-container"></div>
              <p id="q-view-text-base"></p>
              <cite id="q-view-ref"></cite>
            </div>

            <p id="q-view-enunciado" class="q-statement"></p>

            <!-- Alternativas Embaralhadas -->
            <form id="q-options-form" class="exam-options-list" role="radiogroup" aria-label="Alternativas da questão">
              <!-- Gerado via JS para a questão atual -->
            </form>

            <div class="q-clear-row">
              <button type="button" id="btn-clear-answer" class="btn-clear-choice" hidden>
                Limpar resposta selecionada nesta questão
              </button>
            </div>

            <!-- Controles de Navegação: Anterior / Próxima -->
            <div class="question-nav-footer">
              <button type="button" id="btn-prev-question" class="btn btn-secondary">
                Questão Anterior
              </button>
              <button type="button" id="btn-next-question" class="btn btn-primary">
                Próxima Questão
              </button>
            </div>
          </main>
        </div>
      </div>
    </section>

    <!-- FASE 3: TELA DE RESULTADOS E REVISÃO PEDAGÓGICA -->
    <section id="simulado-result-screen" class="section result-section" hidden>
      <div class="container">
        <!-- Card de Resumo do Desempenho -->
        <div class="card result-hero-card">
          <span class="eyebrow eyebrow-wine">Resultado Oficial do Simulado</span>
          <h2 id="result-headline">Desempenho Geral</h2>
          <p id="result-simulado-subtitle" class="result-subtitle"></p>

          <div class="result-stats-grid">
            <div class="stat-box">
              <span class="stat-number" id="result-score-acertos">0 / 45</span>
              <span class="stat-label">Total de Acertos</span>
            </div>

            <div class="stat-box">
              <span class="stat-number" id="result-score-percent">0%</span>
              <span class="stat-label">Aproveitamento</span>
            </div>

            <div class="stat-box">
              <span class="stat-number" id="result-stat-tempo-total">00:00:00</span>
              <span class="stat-label">Tempo Total de Prova</span>
            </div>

            <div class="stat-box">
              <span class="stat-number" id="result-stat-tempo-medio">0min 00s</span>
              <span class="stat-label">Tempo Médio por Questão</span>
            </div>
          </div>

          <div class="result-feedback-box" id="result-feedback-msg">
            <!-- Mensagem contextual de feedback da professora -->
          </div>

          <div class="result-actions-row">
            <button type="button" id="btn-restart-simulado" class="btn btn-primary">
              Voltar ao Início / Novo Simulado
            </button>
            <a href="/enem/exercicios" class="btn btn-secondary">
              Explorar Banco de Questões Completo
            </a>
          </div>
        </div>

        <!-- Lista de Revisão Detalhada Questão a Questão -->
        <div class="result-review-section">
          <div class="review-header">
            <h3>Gabarito Detalhado e Resolução Comentada</h3>
            <p>Revise cada uma das 45 questões resolvidas, veja onde acertou ou errou e leia os comentários pedagógicos fundamentados.</p>
          </div>

          <div class="review-items-list" id="result-review-list">
            <!-- Itens de revisão gerados via JS -->
          </div>
        </div>
      </div>
    </section>

    <!-- MODAL DE ZOOM DE IMAGEM -->
    <div id="image-zoom-modal" class="image-zoom-modal" role="dialog" aria-modal="true" aria-label="Visualização ampliada da imagem" hidden>
      <div class="zoom-modal-backdrop" id="zoom-modal-backdrop"></div>
      <div class="zoom-modal-content">
        <div class="zoom-modal-toolbar">
          <div class="zoom-controls-group">
            <button type="button" id="btn-zoom-out" class="btn btn-secondary btn-xs" aria-label="Diminuir zoom" title="Diminuir zoom (−)">
              −
            </button>
            <span id="zoom-level-indicator" class="zoom-level-badge">100%</span>
            <button type="button" id="btn-zoom-in" class="btn btn-secondary btn-xs" aria-label="Aumentar zoom" title="Aumentar zoom (+)">
              +
            </button>
            <button type="button" id="btn-zoom-reset" class="btn btn-secondary btn-xs" aria-label="Restaurar zoom original" title="Tamanho original (100%)">
              1:1
            </button>
          </div>
          <button type="button" id="btn-close-zoom-modal" class="btn btn-primary btn-xs" aria-label="Fechar janela de imagem">
            Fechar
          </button>
        </div>
        <div class="zoom-modal-stage" id="zoom-modal-stage">
          <img id="zoom-modal-img" src="" alt="" class="zoom-modal-img" />
        </div>
        <p id="zoom-modal-caption" class="zoom-modal-caption"></p>
      </div>
    </div>
  </div>

  <!-- Ícone SVG de lixeira serializado para renderização client-side -->
  <template id="tmpl-trash-icon"><Fragment set:html={trashIcon} /></template>
  <!-- Banco completo serializado para processamento puramente client-side -->
  <script id="dados-questoes" type="application/json" set:html={JSON.stringify(todasQuestoes)} />
</BaseLayout>

<script>
  interface Alternativa {
    letra: string;
    texto: string;
  }

  interface QuestaoImagem {
    arquivo: string;
    alt: string;
  }

  interface Questao {
    id: string;
    ano?: number;
    numeroQuestao?: number;
    idioma?: string;
    origem: string;
    categoria: string;
    habilidade: string;
    titulo: string;
    textoBase: string;
    referenciaTexto: string;
    enunciado: string;
    alternativas: Alternativa[];
    gabarito: string;
    comentarioPedagogico: string;
    imagens?: QuestaoImagem[];
  }

  interface SimuladoItem {
    questao: Questao;
    alternativasShuffled: {
      letraExibida: string; // 'A', 'B', 'C', 'D', 'E'
      letraOriginal: string; // Letra no gabarito oficial
      texto: string;
    }[];
    respostaEscolhida?: string; // Letra original escolhida
    respostaEscolhidaExibida?: string; // Letra exibida marcada ('A'..'E')
  }

  interface SavedSimuladoItemState {
    questaoId: string;
    letrasOrdemOriginal: string[];
    respostaEscolhida?: string;
    respostaEscolhidaExibida?: string;
  }

  interface SavedSimuladoRecord {
    id: string;
    titulo: string;
    modo: 'oficial' | 'aleatorio';
    ano?: number;
    lingua: string;
    createdAt: string;
    updatedAt: string;
    status: 'em_andamento' | 'concluido';
    timerSeconds: number;
    currentIndex: number;
    acertosCount?: number;
    totalQuestions: number;
    itemsState: SavedSimuladoItemState[];
  }

  const STORAGE_KEY = 'jdx_enem_simulados_v1';
  const MAX_SAVED_SIMULADOS = 10;

  function escapeHtml(str: string): string {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function sanitizeSimuladoTitle(title: string): string {
    return String(title || '').replace(/\s*[—-]\s*Caderno\s+[^\s(]+/gi, '');
  }

  // Carregar dados
  const tmplTrashIcon = document.getElementById('tmpl-trash-icon') as HTMLTemplateElement | null;
  const trashIconHtml = tmplTrashIcon ? tmplTrashIcon.innerHTML.trim() : '';
  const questoesRaw = JSON.parse(document.getElementById('dados-questoes')?.textContent || '[]') as Questao[];
  const questoesMap = new Map<string, Questao>(questoesRaw.map((q) => [q.id, q]));

  // Elementos do DOM
  const simuladoHeaderSection = document.getElementById('simulado-header-section') as HTMLElement;
  const setupScreen = document.getElementById('simulado-setup-screen') as HTMLElement;
  const examScreen = document.getElementById('simulado-exam-screen') as HTMLElement;
  const resultScreen = document.getElementById('simulado-result-screen') as HTMLElement;

  const recentSimuladosSection = document.getElementById('recent-simulados-section') as HTMLElement;
  const recentSimuladosList = document.getElementById('recent-simulados-list') as HTMLElement;
  const btnClearHistory = document.getElementById('btn-clear-history') as HTMLButtonElement;

  const setupForm = document.getElementById('simulado-setup-form') as HTMLFormElement;
  const selectAno = document.getElementById('select-ano') as HTMLSelectElement;
  const picklistAno = document.getElementById('picklist-ano') as HTMLElement;
  const picklistAnoTrigger = document.getElementById('picklist-ano-trigger') as HTMLButtonElement;
  const picklistAnoLabel = document.getElementById('picklist-ano-label') as HTMLElement;
  const picklistAnoOptions = document.getElementById('picklist-ano-options') as HTMLElement;
  const configOficialGroup = document.getElementById('config-oficial-group') as HTMLElement;

  // Top Bar e Mapa do Exame
  const examProvaTitle = document.getElementById('exam-prova-title') as HTMLElement;
  const examProgressBarFill = document.getElementById('exam-progress-bar-fill') as HTMLElement;
  const examTimerDisplay = document.getElementById('exam-timer-display') as HTMLElement;
  const examTimerDisplayDesktop = document.getElementById('exam-timer-display-desktop') as HTMLElement;
  const btnPauseTimer = document.getElementById('btn-pause-timer') as HTMLButtonElement;
  const btnPauseTimerDesktop = document.getElementById('btn-pause-timer-desktop') as HTMLButtonElement;
  const btnToggleMapMobile = document.getElementById('btn-toggle-map-mobile') as HTMLButtonElement;
  const mobileMapBtnText = document.getElementById('mobile-map-btn-text') as HTMLElement;
  const sidebarLegendInfo = document.getElementById('sidebar-legend-info') as HTMLElement;
  const btnCloseMapMobile = document.getElementById('btn-close-map-mobile') as HTMLButtonElement;
  const examSidebarPanel = document.getElementById('exam-sidebar-panel') as HTMLElement;
  const btnSaveExitExam = document.getElementById('btn-save-exit-exam') as HTMLButtonElement;
  const btnSaveExitExamDesktop = document.getElementById('btn-save-exit-exam-desktop') as HTMLButtonElement;
  const btnFinishExam = document.getElementById('btn-finish-exam') as HTMLButtonElement;
  const btnFinishExamDesktop = document.getElementById('btn-finish-exam-desktop') as HTMLButtonElement;
  const examQuestionsGrid = document.getElementById('exam-questions-grid') as HTMLElement;

  // Viewport da Questão
  const examQuestionViewport = document.getElementById('exam-question-viewport') as HTMLElement;
  const qViewNum = document.getElementById('q-view-num') as HTMLElement;
  const qViewCat = document.getElementById('q-view-cat') as HTMLElement;
  const qViewHabilidade = document.getElementById('q-view-habilidade') as HTMLElement;
  const qViewStatusPill = document.getElementById('q-view-status-pill') as HTMLElement;
  const qViewTitle = document.getElementById('q-view-title') as HTMLElement;
