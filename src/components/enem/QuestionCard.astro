---
import type { QuestaoComentada } from '../../utils/content';

interface Props {
  questao: QuestaoComentada;
  index: number;
}

const { questao, index } = Astro.props;
const searchNormalized = `${questao.id} ${questao.titulo} ${questao.categoria} ${questao.textoBase} ${questao.enunciado} ${questao.ano || ''}`
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase();
---

<article
  class="card question-card"
  id={questao.id}
  data-categoria={questao.categoria}
  data-ano={questao.ano || ''}
  data-gabarito={questao.gabarito}
  data-search={searchNormalized}
>
  <div class="q-header">
    <div class="q-badges">
      {questao.ano && <span class="badge badge-wine">ENEM {questao.ano}</span>}
      {questao.numeroQuestao && <span class="badge badge-slate">Questão {String(questao.numeroQuestao).padStart(2, '0')}</span>}
      <span class="badge badge-rose">{questao.categoria}</span>
    </div>
    <div class="q-header-right">
      <span class="q-skill">{questao.habilidade}</span>
    </div>
  </div>

  <h3 class="q-title">
    <span class="q-num">#{String(index + 1).padStart(2, '0')}</span>
    {questao.titulo}
  </h3>

  <div class="q-support-text">
    {
      questao.imagens && questao.imagens.length > 0 && (
        <div class="q-images-container">
          {questao.imagens.map((img) => (
            <figure class="q-image-figure">
              <img
                src={`/assets/questoes/${img.arquivo}`}
                alt={img.alt}
                loading="lazy"
                class="q-image"
              />
              {img.alt && <figcaption class="q-image-caption">{img.alt}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }
    <p>{questao.textoBase}</p>
    <cite>{questao.referenciaTexto}</cite>
  </div>

  <p class="q-statement">{questao.enunciado}</p>

  <ul class="q-options-list" role="list" aria-label={`Alternativas para ${questao.titulo}`}>
    {
      questao.alternativas.map((alt) => (
        <li class="q-option-item">
          <span class="q-opt-letter">{alt.letra}</span>
          <span class="q-opt-text">{alt.texto}</span>
        </li>
      ))
    }
  </ul>

  <details class="q-resolution">
    <summary>Ver gabarito oficial e comentário pedagógico</summary>
    <div class="q-resolution-body">
      <p class="q-answer-badge">
        Gabarito Oficial: <strong>Alternativa {questao.gabarito}</strong>
      </p>
      <p class="q-commentary">{questao.comentarioPedagogico}</p>
    </div>
  </details>
</article>

<style>
  .question-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .q-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .q-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .q-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .badge-wine {
    background-color: var(--color-wine-800);
    color: var(--color-cream-50);
  }

  .q-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .q-skill {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    font-weight: 500;
  }

  .q-title {
    font-size: 1.15rem;
    color: var(--color-ink-900);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    line-height: 1.4;
  }

  .q-num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-rose-700);
    font-weight: 700;
  }

  .q-support-text {
    background-color: var(--color-cream-100);
    border-left: 3px solid var(--color-gold-500);
    padding: 1rem 1.15rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .q-images-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
    align-items: center;
  }

  .q-image-figure {
    margin: 0;
    max-width: 100%;
    text-align: center;
  }

  .q-image {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-cream-300);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .q-image-caption {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    margin-top: 0.35rem;
    font-style: italic;
  }

  .q-support-text p {
    font-size: var(--text-sm);
    color: var(--color-ink-900);
    white-space: pre-line;
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  .q-support-text cite {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    font-style: normal;
    text-align: right;
  }

  .q-statement {
    font-weight: 600;
    color: var(--color-ink-900);
    font-size: 1rem;
    line-height: 1.5;
  }

  .q-options-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .q-option-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-cream-300);
    background-color: var(--color-cream-50);
  }

  .q-opt-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background-color: var(--color-cream-200);
    color: var(--color-ink-900);
    font-weight: 700;
    font-size: var(--text-xs);
    flex-shrink: 0;
  }

  .q-opt-text {
    font-size: var(--text-sm);
    color: var(--color-ink-900);
    line-height: 1.5;
  }

  .q-resolution {
    border-top: 1px solid var(--color-cream-200);
    padding-top: 0.75rem;
  }

  .q-resolution summary {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-wine-800);
    user-select: none;
    padding: 0.25rem 0;
  }

  .q-resolution summary:hover {
    color: var(--color-wine-900);
    text-decoration: underline;
  }

  .q-resolution-body {
    margin-top: 0.75rem;
    background-color: var(--color-rose-50);
    border: 1px solid var(--color-rose-200);
    border-radius: var(--radius-sm);
    padding: 1rem 1.15rem;
  }

  .q-answer-badge {
    font-size: var(--text-sm);
    color: var(--color-wine-900);
    margin-bottom: 0.5rem;
  }

  .q-answer-badge strong {
    font-weight: 700;
    color: var(--color-wine-800);
    background: #fff;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-rose-300);
  }

  .q-commentary {
    font-size: var(--text-sm);
    color: var(--color-ink-700);
    line-height: 1.65;
  }
</style>
