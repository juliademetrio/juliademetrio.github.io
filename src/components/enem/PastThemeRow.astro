---
import type { TemaAnterior } from '../../utils/content';
import { getEixoMeta } from '../../utils/eixos';

interface Props {
  tema: TemaAnterior;
}

const { tema } = Astro.props;
const eixoMeta = getEixoMeta(tema.eixo);

const periodo =
  tema.ano >= 2020 ? '2020-2025' : tema.ano >= 2015 ? '2015-2019' : '2010-2014';
---

<article
  class="card past-theme-row"
  data-eixo={tema.eixo}
  data-periodo={periodo}
  data-search={`${tema.ano} ${tema.fraseTema} ${tema.palavrasChave.join(' ')} ${tema.recorteBanca}`.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()}
>
  <div class="past-main">
    <div class="past-year-badge">
      <span class="past-year">{tema.ano}</span>
      <span class="past-edicao">ENEM</span>
    </div>

    <div class="past-content">
      <div class="past-meta">
        <span class={`badge ${eixoMeta.badgeClass}`}>{eixoMeta.label}</span>
        <div class="past-keywords">
          {tema.palavrasChave.map((kw) => <span class="kw-tag">#{kw}</span>)}
        </div>
      </div>

      <h3 class="past-title">"{tema.fraseTema}"</h3>

      <details class="past-details">
        <summary>Ver análise da proposta e repertórios recomendados</summary>
        <div class="past-details-body">
          <div class="detail-block">
            <strong>O que o tema exigia do candidato:</strong>
            <p>{tema.recorteBanca}</p>
          </div>
          <div class="detail-block highlight">
            <strong>Como estruturar e repertoriar este tema:</strong>
            <p>{tema.comoTrabalhar}</p>
          </div>
        </div>
      </details>
    </div>
  </div>
</article>

<style>
  .past-theme-row {
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .past-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .past-main {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .past-year-badge {
    display: inline-flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.5rem;
    background-color: var(--color-wine-900);
    color: var(--color-cream-50);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .past-year-badge {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 84px;
      padding: 0.75rem 0.85rem;
      gap: 0.1rem;
    }
  }

  .past-year {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-gold-300);
    line-height: 1.1;
  }

  .past-edicao {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cream-200);
  }

  .past-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .past-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .past-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .kw-tag {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    background-color: var(--color-cream-100);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  .past-title {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    color: var(--color-ink-900);
    line-height: 1.35;
  }

  .past-details {
    margin-top: 0.25rem;
    border-top: 1px solid var(--color-cream-200);
    padding-top: 0.65rem;
  }

  .past-details summary {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-wine-800);
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .past-details summary::-webkit-details-marker {
    display: none;
  }

  .past-details summary::after {
    content: '+';
    font-weight: 700;
    font-size: 1.1rem;
  }

  .past-details[open] summary::after {
    content: '−';
  }

  .past-details-body {
    margin-top: 0.85rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .past-details-body {
      grid-template-columns: 1fr 1fr;
    }
  }

  .detail-block {
    background-color: var(--color-cream-100);
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
  }

  .detail-block.highlight {
    background-color: var(--color-rose-50);
    border-left: 3px solid var(--color-wine-800);
  }

  .detail-block strong {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-wine-900);
    margin-bottom: 0.35rem;
  }

  .detail-block p {
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
