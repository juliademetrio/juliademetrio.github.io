---
import type { TemaProvavel } from '../../utils/content';
import { getRepertorioForTema } from '../../utils/content';
import { getEixoMeta } from '../../utils/eixos';
import { url } from '../../utils/urls';

interface Props {
  tema: TemaProvavel;
}

const { tema } = Astro.props;
const eixoMeta = getEixoMeta(tema.eixo);
const repertorio = getRepertorioForTema(tema);
---

<article
  class="card probable-card"
  data-eixo={tema.eixo}
  data-search={`${tema.titulo} ${tema.fraseTemaSugerida} ${tema.palavrasChave.join(' ')} ${tema.porQuePodeCair}`.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()}
>
  <div class="prob-top">
    <span class={`badge ${eixoMeta.badgeClass}`}>{eixoMeta.label}</span>
    {tema.destaque && <span class="badge badge-gold">Aposta Quente</span>}
  </div>

  <h3 class="prob-title">
    <a href={url(`/enem/temas-provaveis/${tema.slug}`)}>{tema.titulo}</a>
  </h3>

  <div class="prob-quote">
    <span class="prob-quote-label">Frase-tema sugerida para treino:</span>
    <p>"{tema.fraseTemaSugerida}"</p>
  </div>

  <p class="prob-why">{tema.porQuePodeCair}</p>

  <div class="prob-repertoire-preview">
    <div class="rep-pill">
      <strong>{repertorio.livros.length} Livros:</strong>
      <span>{repertorio.livros.map((l) => l.titulo).join(' • ')}</span>
    </div>
    <div class="rep-pill">
      <strong>{repertorio.filmes.length} Filmes/Docs:</strong>
      <span>{repertorio.filmes.map((f) => f.titulo.split(' (')[0]).join(' • ')}</span>
    </div>
    <div class="rep-pill">
      <strong>{repertorio.textos.length} Textos/Leis:</strong>
      <span>{repertorio.textos.map((t) => t.autoria.split(' /')[0]).join(' • ')}</span>
    </div>
  </div>

  <div class="prob-footer">
    <a href={url(`/enem/temas-provaveis/${tema.slug}`)} class="btn btn-secondary prob-btn">
      Ver tese, livros, filmes e repertórios
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>

<style>
  .probable-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
  }

  .prob-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .prob-title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .prob-title a {
    color: var(--color-ink-900);
    transition: color 0.15s ease;
  }

  .prob-title a:hover {
    color: var(--color-wine-800);
  }

  .prob-quote {
    background-color: var(--color-rose-50);
    border: 1px solid var(--color-rose-200);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.95rem;
  }

  .prob-quote-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-rose-700);
    margin-bottom: 0.2rem;
  }

  .prob-quote p {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-wine-900);
  }

  .prob-why {
    font-size: var(--text-sm);
    color: var(--color-ink-700);
    line-height: 1.6;
  }

  .prob-repertoire-preview {
    margin-top: auto;
    background-color: var(--color-cream-100);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--text-xs);
  }

  .rep-pill {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    line-height: 1.45;
  }

  .rep-pill strong {
    color: var(--color-wine-900);
  }

  .rep-pill span {
    color: var(--color-ink-700);
  }

  .prob-footer {
    padding-top: 0.35rem;
  }

  .prob-btn {
    width: 100%;
  }
</style>
