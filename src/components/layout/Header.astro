---
import { Image } from 'astro:assets';
import logoHorizontalImg from '../../assets/images/logo-horizontal.png';
import whatsappIcon from '../../assets/icons/whatsapp.svg?raw';
import menuIcon from '../../assets/icons/menu.svg?raw';
import closeIcon from '../../assets/icons/close.svg?raw';
import chevronDownIcon from '../../assets/icons/chevron-down.svg?raw';
import { SITE } from '../../data/site';
import { url, buildWhatsAppUrl } from '../../utils/urls';

const currentPath = Astro.url.pathname;
const whatsappCtaUrl = buildWhatsAppUrl(
  SITE.contact.phoneE164,
  'Olá, professora Júlia! Vim pelo seu site e gostaria de conversar sobre aulas, mentoria de redação ou serviços textuais.',
);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={url('/')} class="brand-link" aria-label="Página inicial de Júlia Demetrio Xavier">
      <Image
        src={logoHorizontalImg}
        alt="Logo Júlia Demetrio Xavier"
        width={210}
        height={70}
        class="brand-logo"
        loading="eager"
      />
    </a>

    <!-- Navegação Desktop -->
    <nav class="desktop-nav" aria-label="Navegação principal">
      <ul class="nav-list">
        <li class="nav-dropdown">
          <a
            href={url('/')}
            class:list={['nav-link', 'has-submenu', { active: currentPath === url('/') || currentPath.includes('/enem') }]}
          >
            Portal ENEM
            <Fragment set:html={chevronDownIcon} />
          </a>
          <div class="dropdown-menu">
            <a href={url('/')} class="dropdown-item">
              <strong>Início — Portal ENEM</strong>
              <span>Acesso rápido a todos os recursos de estudo</span>
            </a>
            <a href={url('/enem/temas-provaveis')} class="dropdown-item">
              <strong>Temas Prováveis (2026/2027+)</strong>
              <span>12 apostas comentadas com livros, filmes e textos</span>
            </a>
            <a href={url('/enem/repertorio')} class="dropdown-item">
              <strong>Banco de Repertório</strong>
              <span>Livros, filmes, filósofos e leis por eixo temático</span>
            </a>
            <a href={url('/enem/temas-anteriores')} class="dropdown-item">
              <strong>Temas Anteriores (2010–2025)</strong>
              <span>Linha do tempo comentada das últimas 16 edições</span>
            </a>
            <a href={url('/enem/competencias')} class="dropdown-item">
              <strong>5 Competências & Os 10 Passos</strong>
              <span>Critérios oficiais do INEP e estrutura passo a passo</span>
            </a>
            <a href={url('/enem/exercicios')} class="dropdown-item">
              <strong>Questões Comentadas Online</strong>
              <span>91 questões reais com gabarito e resolução comentada</span>
            </a>
          </div>
        </li>
        <li>
          <a href={url('/sobre')} class:list={['nav-link', { active: currentPath.includes('/sobre') }]}>
            Sobre
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href={whatsappCtaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary header-cta"
      >
        <Fragment set:html={whatsappIcon} />
        Falar com a Professora
      </a>

      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-open"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <Fragment set:html={menuIcon} />
      </button>
    </div>
  </div>
</header>

<!-- Menu Mobile Responsivo (fora do header para não sofrer contenção de altura pelo backdrop-filter) -->
<div class="mobile-drawer" id="mobile-nav-drawer" hidden>
  <div class="mobile-drawer-backdrop" id="mobile-menu-backdrop"></div>
  <div class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-label="Menu principal">
    <div class="mobile-drawer-header">
      <span class="mobile-drawer-title">Menu de Navegação</span>
      <button
        type="button"
        class="mobile-menu-close"
        id="mobile-menu-close"
        aria-label="Fechar menu de navegação"
      >
        <Fragment set:html={closeIcon} />
      </button>
    </div>

    <nav class="mobile-nav-links" aria-label="Navegação mobile">
      <a href={url('/')} class="mobile-link">Portal ENEM (Início)</a>
      <div class="mobile-group">
        <span class="mobile-group-title">Recursos do Portal ENEM</span>
        <a href={url('/enem/temas-provaveis')} class="mobile-sublink">Temas Prováveis (2026/2027+)</a>
        <a href={url('/enem/repertorio')} class="mobile-sublink">Banco de Repertório</a>
        <a href={url('/enem/temas-anteriores')} class="mobile-sublink">Temas Anteriores (2010–2025)</a>
        <a href={url('/enem/competencias')} class="mobile-sublink">As 5 Competências & 10 Passos</a>
        <a href={url('/enem/exercicios')} class="mobile-sublink">Questões Comentadas Online</a>
      </div>
      <a href={url('/sobre')} class="mobile-link">Sobre (Currículo, Serviços & Contato)</a>
    </nav>

    <div class="mobile-drawer-footer">
      <a
        href={whatsappCtaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
        style="width: 100%;"
      >
        <Fragment set:html={whatsappIcon} />
        Falar no WhatsApp
      </a>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const drawer = document.getElementById('mobile-nav-drawer');
  const mobileLinks = drawer?.querySelectorAll('a');

  function toggleMenu(show: boolean) {
    if (!drawer || !openBtn) return;
    if (show) {
      drawer.removeAttribute('hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    } else {
      drawer.setAttribute('hidden', '');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  openBtn?.addEventListener('click', () => toggleMenu(true));
  closeBtn?.addEventListener('click', () => toggleMenu(false));
  backdrop?.addEventListener('click', () => toggleMenu(false));
  mobileLinks?.forEach((link) => link.addEventListener('click', () => toggleMenu(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hasAttribute('hidden')) {
      toggleMenu(false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: rgba(253, 251, 248, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-cream-200);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .desktop-nav {
    display: none;
    margin-left: auto;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-700);
    transition: all 0.18s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-wine-800);
    background-color: var(--color-rose-50);
  }

  .nav-dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    width: 320px;
    background-color: var(--color-cream-50);
    border: 1px solid var(--color-cream-200);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .dropdown-item:hover {
    background-color: var(--color-rose-50);
  }

  .dropdown-item strong {
    font-size: var(--text-sm);
    color: var(--color-wine-900);
    font-weight: 600;
  }

  .dropdown-item span {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-cta {
    display: none;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-cream-300);
    background-color: var(--color-cream-50);
    color: var(--color-ink-900);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  /* Drawer Mobile */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 999;
  }

  .mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(31, 26, 28, 0.45);
    backdrop-filter: blur(2px);
    z-index: 999;
  }

  .mobile-drawer-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    height: 100vh;
    height: 100dvh;
    width: min(88vw, 360px);
    background-color: var(--color-cream-50);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    overflow-y: auto;
    z-index: 1000;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-cream-200);
    flex-shrink: 0;
  }

  .mobile-drawer-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-wine-900);
  }

  .mobile-menu-close {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-cream-200);
    background: transparent;
    color: var(--color-ink-900);
    cursor: pointer;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-block: 1.25rem;
    flex: 1 0 auto;
  }

  .mobile-link {
    display: block;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--color-ink-900);
  }

  .mobile-link:hover {
    background-color: var(--color-rose-50);
    color: var(--color-wine-800);
  }

  .mobile-group {
    background-color: var(--color-cream-100);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    margin-block: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .mobile-group-title {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-rose-700);
    padding: 0.25rem 0.5rem;
  }

  .mobile-sublink {
    display: block;
    padding: 0.55rem 0.5rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    color: var(--color-ink-700);
  }

  .mobile-sublink:hover {
    background-color: var(--color-cream-50);
    color: var(--color-wine-800);
  }

  .mobile-drawer-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-cream-200);
    flex-shrink: 0;
  }
</style>
