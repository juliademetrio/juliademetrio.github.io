---
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/logo.png';
import whatsappIcon from '../../assets/icons/whatsapp.svg?raw';
import emailIcon from '../../assets/icons/email.svg?raw';
import linkedinIcon from '../../assets/icons/linkedin.svg?raw';
import { SITE } from '../../data/site';
import { url, buildWhatsAppUrl } from '../../utils/urls';

const currentYear = new Date().getFullYear();
const whatsappUrl = buildWhatsAppUrl(
  SITE.contact.phoneE164,
  'Olá, professora Júlia! Vim pelo seu site e gostaria de conversar.',
);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo-badge">
        <Image
          src={logoImg}
          alt="Logo Júlia Demetrio Xavier"
          width={180}
          height={56}
          class="footer-logo"
        />
      </div>
      <p class="footer-bio">{SITE.shortBio}</p>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Portal ENEM</h3>
      <ul class="footer-links">
        <li><a href={url('/')}>Início — Portal ENEM</a></li>
        <li><a href={url('/enem/temas-provaveis')}>Temas Prováveis (2026/2027+)</a></li>
        <li><a href={url('/enem/repertorio')}>Banco de Repertório Sociocultural</a></li>
        <li><a href={url('/enem/temas-anteriores')}>Temas Anteriores (2010–2025)</a></li>
        <li><a href={url('/enem/competencias')}>As 5 Competências & 10 Passos</a></li>
        <li><a href={url('/enem/exercicios')}>Questões Comentadas Online</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Sobre a Professora</h3>
      <ul class="footer-links">
        <li><a href={url('/sobre')}>Apresentação & Bio</a></li>
        <li><a href={url('/sobre#curriculo')}>Formação & Experiência</a></li>
        <li><a href={url('/sobre#servicos')}>Serviços</a></li>
        <li><a href={url('/sobre#contato')}>Contato</a></li>
        <li><a href={url('/privacidade')}>Política de Privacidade</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Canais de Contato</h3>
      <p class="footer-contact-desc">
        Fale diretamente com a professora pelos canais oficiais:
      </p>
      <div class="footer-icon-buttons" role="group" aria-label="Canais de contato da professora">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-icon-btn"
          aria-label="Conversar pelo WhatsApp"
          title="WhatsApp"
        >
          <Fragment set:html={whatsappIcon} />
        </a>
        <a
          href={`mailto:${SITE.contact.email}`}
          class="footer-icon-btn"
          aria-label="Enviar e-mail"
          title="E-mail"
        >
          <Fragment set:html={emailIcon} />
        </a>
        <a
          href={SITE.contact.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-icon-btn"
          aria-label="Acessar perfil no LinkedIn"
          title="LinkedIn"
        >
          <Fragment set:html={linkedinIcon} />
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="footer-legal">
      <p>© {currentYear} {SITE.name}. Todos os direitos reservados.</p>
      <p class="footer-disclaimer">
        Portal educacional independente. "ENEM" é marca registrada do INEP/MEC.
      </p>
    </div>
    <p class="footer-dev">
      Desenvolvido por{' '}
      <a
        href="https://www.linkedin.com/in/ldmelo"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-dev-link"
      >
        Lucas Daniel de Melo Borges
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-wine-900);
    color: var(--color-cream-100);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(237, 228, 216, 0.14);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    }
  }

  .footer-logo-badge {
    display: inline-block;
    background-color: var(--color-cream-50);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .footer-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .footer-bio {
    color: var(--color-cream-200);
    font-size: var(--text-sm);
    margin-bottom: 0.75rem;
    max-width: 36ch;
  }

  .footer-heading {
    color: var(--color-gold-300);
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--color-cream-200);
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-gold-300);
  }

  .footer-contact-desc {
    color: var(--color-cream-200);
    font-size: var(--text-sm);
    margin-bottom: 0.9rem;
    line-height: 1.5;
  }

  .footer-icon-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-icon-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(253, 251, 248, 0.1);
    border: 1px solid rgba(226, 200, 157, 0.3);
    color: var(--color-cream-100);
    transition: all 0.2s ease;
  }

  .footer-icon-btn:hover {
    background-color: var(--color-gold-300);
    border-color: var(--color-gold-300);
    color: var(--color-wine-900);
    transform: translateY(-2px);
  }

  .footer-bottom {
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-bottom p {
    color: var(--color-cream-300);
    font-size: var(--text-xs);
  }

  .footer-dev-link {
    color: var(--color-gold-300);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .footer-dev-link:hover {
    color: var(--color-cream-50);
  }
</style>
