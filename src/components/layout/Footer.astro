---
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/logo.png';
import { SITE } from '../../data/site';
import { url, buildWhatsAppUrl } from '../../utils/urls';

const currentYear = new Date().getFullYear();
const whatsappUrl = buildWhatsAppUrl(
  SITE.contact.phoneE164,
  'Olá, professora Júlia! Vim pelo seu site e gostaria de conversar.',
);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo-badge">
        <Image
          src={logoImg}
          alt="Logo Júlia Demetrio Xavier"
          width={180}
          height={56}
          class="footer-logo"
        />
      </div>
      <p class="footer-bio">{SITE.shortBio}</p>
      <p class="footer-modality">{SITE.contact.modality}</p>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Portal ENEM</h3>
      <ul class="footer-links">
        <li><a href={url('/')}>Início — Portal ENEM</a></li>
        <li><a href={url('/enem/temas-provaveis')}>Temas Prováveis (2026/2027+)</a></li>
        <li><a href={url('/enem/repertorio')}>Banco de Repertório Sociocultural</a></li>
        <li><a href={url('/enem/temas-anteriores')}>Temas Anteriores (2010–2025)</a></li>
        <li><a href={url('/enem/competencias')}>As 5 Competências & 10 Passos</a></li>
        <li><a href={url('/enem/exercicios')}>Questões Comentadas Online</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Sobre a Professora</h3>
      <ul class="footer-links">
        <li><a href={url('/sobre')}>Apresentação & Bio</a></li>
        <li><a href={url('/sobre#curriculo')}>Formação & Experiência</a></li>
        <li><a href={url('/sobre#servicos')}>Serviços Pedagógicos & Editoriais</a></li>
        <li><a href={url('/sobre#contato')}>Contato</a></li>
        <li><a href={url('/privacidade')}>Política de Privacidade</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Canais de Contato</h3>
      <ul class="footer-contact-list">
        <li>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp: {SITE.contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.contact.email}`}>
            {SITE.contact.email}
          </a>
        </li>
        <li>
          <a href={SITE.contact.linkedinUrl} target="_blank" rel="noopener noreferrer">
            LinkedIn: {SITE.contact.linkedinHandle}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} {SITE.name}. Todos os direitos reservados.</p>
    <p class="footer-disclaimer">
      Portal educacional independente. "ENEM" é marca registrada do INEP/MEC.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-wine-900);
    color: var(--color-cream-100);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(237, 228, 216, 0.14);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    }
  }

  .footer-logo-badge {
    display: inline-block;
    background-color: var(--color-cream-50);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .footer-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .footer-bio {
    color: var(--color-cream-200);
    font-size: var(--text-sm);
    margin-bottom: 0.75rem;
    max-width: 36ch;
  }

  .footer-modality {
    color: var(--color-gold-300);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-heading {
    color: var(--color-gold-300);
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .footer-links,
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--text-sm);
  }

  .footer-links a,
  .footer-contact-list a {
    color: var(--color-cream-200);
    transition: color 0.15s ease;
  }

  .footer-links a:hover,
  .footer-contact-list a:hover {
    color: var(--color-gold-300);
  }

  .footer-bottom {
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-bottom p {
    color: var(--color-cream-300);
    font-size: var(--text-xs);
  }
</style>
